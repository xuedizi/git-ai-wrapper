+#[test]
+fn install_hooks_target_dry_run_preserves_files_and_suggestion() {
+    let repo = TestRepo::new_with_daemon_scope(DaemonTestScope::NoDaemon);
+    let home = repo.test_home_path();
+    for tool in [".codebuddy", ".claude"] {
+        fs::create_dir_all(home.join(tool)).unwrap();
+        fs::write(home.join(tool).join("settings.json"), "{}").unwrap();
+    }
+    let output = repo
+        .git_ai_command_without_pre_sync_for_test(
+            &[
+                "install-hooks",
+                "--target=codebuddy,claude-code",
+                "--target=codebuddy",
+                "--visual-studio-extension",
+                "--dry-run",
+            ],
+            &[],
+        )
+        .output()
+        .unwrap();
+    assert!(
+        output.status.success(),
+        "{}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    let stdout = String::from_utf8_lossy(&output.stdout);
+    assert!(stdout.contains("CodeBuddy:"), "{stdout}");
+    assert!(stdout.contains("Claude Code:"), "{stdout}");
+    assert!(
+        stdout.contains("--dry-run=false --target claude-code,codebuddy --visual-studio-extension"),
+        "{stdout}"
+    );
+    for tool in [".codebuddy", ".claude"] {
+        assert_eq!(
+            fs::read_to_string(home.join(tool).join("settings.json")).unwrap(),
+            "{}"
+        );
+    }
+}
