+fn parse_targets(value: &str, options: &mut InstallOptions) -> Result<(), GitAiError> {
+    let available: BTreeSet<String> = get_all_installers()
+        .iter()
+        .map(|installer| installer.id().to_string())
+        .collect();
+    for target in value.split(',').map(str::trim) {
+        if !available.contains(target) {
+            return Err(GitAiError::Generic(format!(
+                "invalid --target {target:?}. Available targets on this platform: {}",
+                available.into_iter().collect::<Vec<_>>().join(", ")
+            )));
+        }
+        options
+            .targets
+            .get_or_insert_with(BTreeSet::new)
+            .insert(target.to_string());
+    }
+    Ok(())
 }
 
