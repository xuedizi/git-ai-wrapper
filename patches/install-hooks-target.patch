+#[test]
+fn install_hooks_target_invalid_and_uninstall_rejected_before_writes() {
+    let repo = TestRepo::new_with_daemon_scope(DaemonTestScope::NoDaemon);
+    let home = repo.test_home_path();
+    fs::create_dir_all(home.join(".codebuddy")).unwrap();
+    let settings = home.join(".codebuddy/settings.json");
+    fs::write(&settings, "{\"hooks\":{}}").unwrap();
+    let gitconfig_before = fs::read(home.join(".gitconfig")).ok();
+    for args in [
+        vec!["install-hooks", "--target=unknown", "--env"],
+        vec!["install-hooks", "--target=codebuddy", "--skills"],
+        vec!["uninstall-hooks", "--target=codebuddy"],
+        vec!["uninstall", "--target", "codebuddy"],
+    ] {
+        let output = repo
+            .git_ai_command_without_pre_sync_for_test(&args, &[])
+            .output()
+            .unwrap();
+        assert!(
+            !output.status.success(),
+            "accepted {args:?}: {}",
+            String::from_utf8_lossy(&output.stdout)
+        );
+        assert!(String::from_utf8_lossy(&output.stderr).contains("--target"));
+        assert_eq!(fs::read_to_string(&settings).unwrap(), "{\"hooks\":{}}");
+        assert_eq!(fs::read(home.join(".gitconfig")).ok(), gitconfig_before);
+    }
