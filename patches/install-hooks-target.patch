+// Targeted installs must not enter another tool's installer or global Skills cleanup.
+#[test]
+fn install_hooks_target_preserves_unselected_tools_and_skills() {
+    let repo = TestRepo::new_with_daemon_scope(DaemonTestScope::NoDaemon);
+    let home = repo.test_home_path();
+    let protected = [
+        ".claude/settings.json",
+        ".cursor/hooks.json",
+        ".codex/config.toml",
+        ".git-ai/skills/prompt-analysis/SKILL.md",
+        ".agents/skills/prompt-analysis/SKILL.md",
+        ".claude/skills/prompt-analysis/SKILL.md",
+        ".cursor/skills/prompt-analysis/SKILL.md",
+    ];
+    for path in protected {
+        let path = home.join(path);
+        fs::create_dir_all(path.parent().unwrap()).unwrap();
+        fs::write(path, "# preserve user content\n").unwrap();
+    }
+    fs::create_dir_all(home.join(".codebuddy")).unwrap();
+    fs::write(
+        home.join(".codebuddy/settings.json"),
+        "{\"userSetting\":true}",
+    )
+    .unwrap();
+    let mut previous = None;
+    for _ in 0..2 {
+        let output = repo
+            .git_ai_command_without_pre_sync_for_test(
+                &["install-hooks", "--target", "codebuddy", "--dry-run=false"],
+                &[],
+            )
+            .output()
+            .unwrap();
+        assert!(
+            output.status.success(),
+            "{}",
+            String::from_utf8_lossy(&output.stderr)
+        );
+        let content = fs::read(home.join(".codebuddy/settings.json")).unwrap();
+        let settings: serde_json::Value = serde_json::from_slice(&content).unwrap();
+        assert_eq!(settings["userSetting"], true);
+        assert!(settings["hooks"]["PreToolUse"].is_array());
+        assert!(settings["hooks"]["PostToolUse"].is_array());
+        if let Some(previous) = previous {
+            assert_eq!(content, previous);
+        }
+        previous = Some(content);
+        for path in protected {
+            assert_eq!(
+                fs::read_to_string(home.join(path)).unwrap(),
+                "# preserve user content\n",
+                "changed {path}"
+            );
+        }
+        let stdout = String::from_utf8_lossy(&output.stdout);
+        for name in [
+            "Claude Code:",
+            "Cursor:",
+            "Codex:",
+            "VS Code:",
+            "Android Studio:",
+        ] {
+            assert!(!stdout.contains(name), "unexpected installer: {stdout}");
+        }
+    }
+}
