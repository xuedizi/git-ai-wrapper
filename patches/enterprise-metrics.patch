+fn enterprise_outbox_atomic_replay_and_lease_recovery() {
+    let (mut db, _dir) = crate::metrics::db::MetricsDatabase::new_temp_for_tests().unwrap();
+    let cfg = config();
+    let raw = serde_json::to_string(&checkpoint("ai_agent")).unwrap();
+    let ids = db.insert_events(&[raw.clone(), raw]).unwrap();
+    let now = 1700000010;
+    {
+        let tx = db.enterprise_connection().transaction().unwrap();
+        store::capture(&tx, ids[0], 4, 100, &cfg, now).unwrap();
+        // Dropping the transaction also drops the enterprise record.
+    }
+    assert_eq!(
+        store::status(db.enterprise_connection(), now).unwrap()["inbox"],
+        json!([])
+    );
+    {
+        let tx = db.enterprise_connection().transaction().unwrap();
+        for id in &ids {
+            store::capture(&tx, *id, 4, 100, &cfg, now).unwrap();
+        }
+        store::capture(&tx, ids[0], 4, 100, &cfg, now).unwrap();
+        tx.commit().unwrap();
+    }
+    store::project_pending(db.enterprise_connection(), &cfg, now).unwrap();
+    let a = store::claim(
+        db.enterprise_connection(),
+        &cfg.destinations[0],
+        "org",
+        "checkpoint",
+        now,
+    )
+    .unwrap()
+    .unwrap();
+    let b = store::claim(
