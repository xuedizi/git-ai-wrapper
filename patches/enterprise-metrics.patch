diff --git a/src/enterprise_metrics/config.rs b/src/enterprise_metrics/config.rs
new file mode 100644
index 000000000..62aa7f73a
--- /dev/null
+++ b/src/enterprise_metrics/config.rs
@@ -0,0 +1,236 @@
+//! Enterprise settings are independent of upstream cloud authentication.
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use sha2::{Digest, Sha256};
+use std::collections::HashSet;
+use std::sync::{Arc, OnceLock, RwLock};
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Settings {
+    #[serde(default)]
+    pub enabled: bool,
+    pub organization_id: String,
+    #[serde(skip, default = "client_version")]
+    pub client_version: String,
+    pub identity_secret: String,
+    pub destinations: Vec<Destination>,
+    #[serde(default = "max_bytes")]
+    pub max_bytes: u64,
+    #[serde(default = "reserved_bytes")]
+    pub commit_reserved_bytes: u64,
+    #[serde(default = "retention_secs")]
+    pub retention_secs: u64,
+}
+fn max_bytes() -> u64 {
+    100 * 1024 * 1024
+}
+fn reserved_bytes() -> u64 {
+    20 * 1024 * 1024
+}
+fn retention_secs() -> u64 {
+    30 * 86400
+}
+#[derive(Clone, Copy, Default, Serialize, Deserialize)]
+pub enum Adapter {
+    #[default]
+    #[serde(rename = "autopai-v1")]
+    AutoPaiV1,
+}
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Destination {
+    #[serde(default)]
+    pub adapter: Adapter,
+    pub id: String,
+    pub endpoint: String,
+    // Never copy credentials into the durable destination snapshot or status output.
+    #[serde(default, skip_serializing)]
+    pub token: String,
+    #[serde(default)]
+    pub ack: Ack,
+    #[serde(default)]
+    pub event_types: Vec<String>,
+    #[serde(default = "interval_ms")]
+    pub min_interval_ms: u64,
+}
+fn interval_ms() -> u64 {
+    500
+}
+#[derive(Clone, Default, Serialize, Deserialize)]
+#[serde(tag = "mode", rename_all = "snake_case", deny_unknown_fields)]
+pub enum Ack {
+    #[default]
+    Unconfirmed,
+    #[serde(rename = "http_200")]
+    Http200,
+    Json {
+        pointer: String,
+        equals: Value,
+        event_id_pointer: Option<String>,
+    },
+}
+impl Destination {
+    /// Bind old work to its original destination, never silently redirect it.
+    pub fn binding(&self) -> String {
+        digest(
+            &serde_json::to_string(&(&self.id, &self.adapter, &self.endpoint, "embedded-v2"))
+                .expect("strings serialize"),
+        )
+    }
+    pub fn token(&self) -> Option<String> {
+        let token = self.token.trim();
+        if token.is_empty() || token.contains(['\r', '\n']) {
+            None
+        } else {
+            Some(token.into())
+        }
+    }
+}
+fn client_version() -> String {
+    super::embedded::WRAPPER_VERSION.into()
+}
+impl Settings {
+    pub fn validate(&self) -> Result<(), String> {
+        if self.organization_id.is_empty()
+            || self.organization_id.len() > 256
+            || self.client_version.len() > 128
+            || self.client_version.is_empty()
+            || self.identity_secret.len() < 32
+            || self.identity_secret.len() > 1024
+        {
+            return Err("organization_id, client_version and identity_secret (at least 32 bytes) are required".into());
+        }
+        if self.destinations.is_empty()
+            || self.destinations.len() > 8
+            || self.max_bytes == 0
+            || self.commit_reserved_bytes >= self.max_bytes
+            || !(60..=365 * 86400).contains(&self.retention_secs)
+        {
+            return Err("invalid destination count or queue limits".into());
+        }
+        let mut ids = HashSet::new();
+        for dest in &self.destinations {
+            let url = url::Url::parse(&dest.endpoint).map_err(|_| "invalid endpoint")?;
+            if url.scheme() != "https"
+                || url.host_str().is_none()
+                || !url.username().is_empty()
+                || url.password().is_some()
+                || url.query().is_some()
+                || url.fragment().is_some()
+            {
+                return Err("endpoint must be HTTPS without credentials, query or fragment".into());
+            }
+            if dest.endpoint.len() > 2048
+                || dest.id.len() > 128
+                || dest.token.len() > 8192
+                || dest.id.is_empty()
+                || !ids.insert(&dest.id)
+                || dest.token().is_none()
+                || dest.min_interval_ms < 100
+                || dest.min_interval_ms > 60000
+                || dest
+                    .event_types
+                    .iter()
+                    .any(|t| t != "checkpoint" && t != "commit")
+            {
+                return Err(
+                    "invalid destination ID, token reference, event types or request interval"
+                        .into(),
+                );
+            }
+            if let Ack::Json {
+                pointer,
+                event_id_pointer,
+                ..
+            } = &dest.ack
+                && (!pointer.starts_with('/')
+                    || event_id_pointer
+                        .as_ref()
+                        .is_some_and(|p| !p.starts_with('/')))
+            {
+                return Err("ack fields must be JSON pointers".into());
+            }
+        }
+        Ok(())
+    }
+    pub fn identity_binding(&self) -> String {
+        digest(&format!(
+            "repository-email-url-v2\0{}",
+            self.identity_secret
+        ))
+    }
+    pub fn opaque(&self, kind: &str, value: &str) -> String {
+        // HMAC-SHA256, implemented using the existing SHA-256 dependency.
+        let mut key = [0u8; 64];
+        let secret = self.identity_secret.as_bytes();
+        if secret.len() > 64 {
+            key[..32].copy_from_slice(&Sha256::digest(secret));
+        } else {
+            key[..secret.len()].copy_from_slice(secret);
+        }
+        let inner_pad = key.map(|b| b ^ 0x36);
+        let outer_pad = key.map(|b| b ^ 0x5c);
+        let message =
+            serde_json::to_vec(&(&self.organization_id, kind, value)).expect("strings serialize");
+        let mut inner = Sha256::new();
+        inner.update(inner_pad);
+        inner.update(message);
+        let mut outer = Sha256::new();
+        outer.update(outer_pad);
+        outer.update(inner.finalize());
+        format!("{kind}-{:x}", outer.finalize())
+    }
+}
+pub fn digest(value: &str) -> String {
+    format!("{:x}", Sha256::digest(value.as_bytes()))
+}
+
+static SETTINGS: OnceLock<RwLock<Option<Arc<Settings>>>> = OnceLock::new();
+static ERROR: OnceLock<RwLock<Option<String>>> = OnceLock::new();
+pub fn current() -> Option<Arc<Settings>> {
+    SETTINGS
+        .get_or_init(|| RwLock::new(None))
+        .read()
+        .ok()?
+        .clone()
+}
+pub fn last_error() -> Option<String> {
+    ERROR.get_or_init(|| RwLock::new(None)).read().ok()?.clone()
+}
+fn load() -> Result<Option<Settings>, String> {
+    // Only test-support binaries accept an external fixture. Production uses embedded data.
+    #[cfg(any(test, feature = "test-support"))]
+    if let Some(path) = std::env::var_os("GIT_AI_TEST_ENTERPRISE_CONFIG") {
+        let bytes = std::fs::read(path).map_err(|_| "cannot read enterprise test config")?;
+        return parse(&bytes);
+    }
+    parse(super::embedded::CONFIG.as_bytes())
+}
+pub(super) fn parse(bytes: &[u8]) -> Result<Option<Settings>, String> {
+    let value: Value =
+        serde_json::from_slice(bytes).map_err(|_| "invalid enterprise config JSON")?;
+    if value.get("enabled").and_then(Value::as_bool) == Some(false) {
+        return Ok(None);
+    }
+    let settings: Settings =
+        serde_json::from_value(value).map_err(|_| "invalid enterprise config JSON")?;
+    settings.validate()?;
+    Ok(Some(settings))
+}
+pub fn reload() {
+    let loaded = load();
+    let (settings, error) = match loaded {
+        Ok(v) => (v.map(Arc::new), None),
+        Err(e) => (None, Some(e)),
+    };
+    *SETTINGS
+        .get_or_init(|| RwLock::new(None))
+        .write()
+        .expect("settings lock") = settings;
+    *ERROR
+        .get_or_init(|| RwLock::new(None))
+        .write()
+        .expect("error lock") = error;
+}
