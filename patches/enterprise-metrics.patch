diff --git a/tests/integration/enterprise_metrics.rs b/tests/integration/enterprise_metrics.rs
new file mode 100644
index 000000000..061c032ce
--- /dev/null
+++ b/tests/integration/enterprise_metrics.rs
@@ -0,0 +1,123 @@
+use crate::repos::test_file::ExpectedLineExt;
+use crate::repos::test_repo::TestRepo;
+use crate::test_utils::isolated_metrics_db_path;
+use serde_json::{Value, json};
+use std::{
+    fs,
+    time::{Duration, Instant},
+};
+
+#[test]
+fn enterprise_metrics_captures_real_checkpoint_and_commit_without_network() {
+    let (_dir, db_path) = isolated_metrics_db_path();
+    let config_dir = tempfile::tempdir().unwrap();
+    let config_path = config_dir.path().join("enterprise.json");
+    let cfg = json!({"enabled":true,"organization_id":"test-org",
+        "identity_secret":"integration-only-secret-long-enough",
+        "destinations":[{"id":"test","endpoint":"https://example.invalid/upload","token":"integration-fixture-token",
+            "ack":{"mode":"unconfirmed"},"event_types":["checkpoint","commit"]}]});
+    fs::write(&config_path, cfg.to_string()).unwrap();
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        fs::set_permissions(&config_path, fs::Permissions::from_mode(0o600)).unwrap();
+    }
+    let repo = TestRepo::new_with_daemon_env(&[
+        ("GIT_AI_TEST_METRICS_DB_PATH", db_path.as_str()),
+        (
+            "GIT_AI_TEST_ENTERPRISE_CONFIG",
+            config_path.to_str().unwrap(),
+        ),
+    ]);
+    repo.git(&[
+        "remote",
+        "add",
+        "origin",
+        "https://example.test/enterprise-repo.git",
+    ])
+    .unwrap();
+    repo.git(&["config", "user.email", "configured@company.test"])
+        .unwrap();
+    let path = repo.path().join("example.txt");
+    fs::write(&path, "base\n").unwrap();
+    repo.stage_all_and_commit("Initial commit").unwrap();
+    let mut file = repo.filename("example.txt");
+    file.assert_committed_lines(lines!["base".unattributed_human()]);
+    let hook = |event: &str| {
+        json!({"session_id":"test-enterprise-session","cwd":repo.canonical_path(),
+        "hook_event_name":event,"tool_name":"apply_patch","tool_use_id":"test-tool-use","model":"gpt-test",
+        "tool_input":{"patch":format!("*** Update File: {}\n",path.display())}}).to_string()
+    };
+    repo.git_ai(&["checkpoint", "codex", "--hook-input", &hook("PreToolUse")])
+        .unwrap();
+    fs::write(&path, "base\nai added\n").unwrap();
+    repo.git_ai(&["checkpoint", "codex", "--hook-input", &hook("PostToolUse")])
+        .unwrap();
+    repo.stage_all_and_commit("PRIVATE enterprise commit message")
+        .unwrap();
+    file.assert_committed_lines(lines!["base".unattributed_human(), "ai added".ai()]);
+    let expected_sha = repo.git(&["rev-parse", "HEAD"]).unwrap().trim().to_string();
+    let deadline = Instant::now() + Duration::from_secs(20);
+    loop {
+        // Explicit control wakes projection. No HTTP is possible with an unconfirmed ACK.
+        let status: Value =
+            serde_json::from_str(&repo.git_ai(&["enterprise-telemetry", "flush"]).unwrap())
+                .unwrap();
+        let conn = rusqlite::Connection::open(&db_path).unwrap();
+        let mut stmt = conn
+            .prepare("SELECT payload FROM enterprise_events ORDER BY created_at")
+            .unwrap();
+        let payloads: Vec<String> = stmt
+            .query_map([], |r| r.get(0))
+            .unwrap()
+            .collect::<Result<_, _>>()
+            .unwrap();
+        let values: Vec<Value> = payloads
+            .iter()
+            .map(|s| serde_json::from_str(s).unwrap())
+            .collect();
+        let checkpoint = values.iter().any(|v| {
+            v["event_type"] == "checkpoint" && v["kind"] == "ai_agent" && v["lines_added"] == 1
+        });
+        let commit = values
+            .iter()
+            .any(|v| v["event_type"] == "commit" && v["ai_additions"] == 1);
+        if checkpoint && commit {
+            for value in &values {
+                assert_eq!(value["user_id"], "configured@company.test");
+                assert_eq!(value["repo_id"], "https://example.test/enterprise-repo");
+                assert_eq!(value["client_version"], "development");
+            }
+            assert!(
+                values
+                    .iter()
+                    .any(|v| v["event_type"] == "commit" && v["commit_id"] == expected_sha)
+            );
+            let destinations: String = conn
+                .query_row(
+                    "SELECT destinations FROM enterprise_inbox LIMIT 1",
+                    [],
+                    |r| r.get(0),
+                )
+                .unwrap();
+            assert!(!destinations.contains("integration-fixture-token"));
+            for body in payloads {
+                for private in [
+                    "PRIVATE enterprise",
+                    "example.txt",
+                    "test@example.com",
+                    "test-enterprise-session",
+                ] {
+                    assert!(!body.contains(private));
+                }
+            }
+            assert_eq!(status["enabled"], true);
+            break;
+        }
+        assert!(
+            Instant::now() < deadline,
+            "two event types not projected; status={status}"
+        );
+        std::thread::sleep(Duration::from_millis(100));
+    }
+}
