diff --git a/src/enterprise_metrics/identity.rs b/src/enterprise_metrics/identity.rs
new file mode 100644
index 000000000..c84d01398
--- /dev/null
+++ b/src/enterprise_metrics/identity.rs
@@ -0,0 +1,91 @@
+//! Repository identity is captured once per metric batch, outside trace ingestion.
+//! Never resolve mutable repository state while projecting or retrying a delivery.
+use crate::{git::repository::Repository, metrics::EventAttributes};
+use std::collections::{BTreeMap, HashMap};
+const USER: &str = "tac_enterprise_user_email";
+const REPO: &str = "tac_enterprise_repo_url";
+
+pub fn capture(repo: &Repository, attrs: EventAttributes) -> EventAttributes {
+    let mut extra: HashMap<String, String> = attrs
+        .custom_attributes
+        .as_ref()
+        .and_then(|v| v.as_ref())
+        .and_then(|v| serde_json::from_str(v).ok())
+        .unwrap_or_default();
+    // Reserved fields cannot be supplied by a user custom-attributes override.
+    extra.remove(USER);
+    extra.remove(REPO);
+    if let Ok(config) = repo.enterprise_config_snapshot() {
+        if let Some(email) = config.string("user.email") {
+            let email = email.to_string();
+            if !email.trim().is_empty() {
+                extra.insert(USER.into(), email.trim().into());
+            }
+        }
+        // Read one effective config snapshot. No git subprocesses or per-file work.
+        let mut remotes = BTreeMap::new();
+        for section in config.sections() {
+            if section.header().name().eq_ignore_ascii_case(b"remote")
+                && let Some(name) = section.header().subsection_name()
+            {
+                let value = remotes.entry(name.to_string()).or_insert(None);
+                if let Some(url) = section.body().value("url") {
+                    *value = Some(url.to_string());
+                }
+            }
+        }
+        let remote = remotes.get("origin").or_else(|| {
+            if remotes.len() == 1 {
+                remotes.values().next()
+            } else {
+                None
+            }
+        });
+        if let Some(url) = remote
+            .and_then(|url| url.as_deref())
+            .and_then(normalize_url)
+        {
+            extra.insert(REPO.into(), url);
+        }
+    }
+    attrs.custom_attributes_map(&extra)
+}
+
+pub fn from_attrs(attrs: &EventAttributes) -> (Option<String>, Option<String>) {
+    let extra: HashMap<String, String> = attrs
+        .custom_attributes
+        .as_ref()
+        .and_then(|v| v.as_ref())
+        .and_then(|v| serde_json::from_str(v).ok())
+        .unwrap_or_default();
+    let user = extra.get(USER).filter(|s| !s.trim().is_empty()).cloned();
+    let repo = extra.get(REPO).and_then(|s| normalize_url(s));
+    (user, repo)
+}
+
+/// Canonical repository identity, not an HTTP transport URL. Preserve nonstandard
+/// ports so different repositories never collapse into one enterprise identifier.
+fn normalize_url(raw: &str) -> Option<String> {
+    let raw = raw.trim();
+    let expanded;
+    let source = if !raw.contains("://") {
+        let (host, path) = raw.split_once(':')?;
+        if host.len() <= 1 || host.contains('/') || path.is_empty() {
+            return None;
+        }
+        expanded = format!("ssh://{host}/{}", path.trim_start_matches('/'));
+        expanded.as_str()
+    } else {
+        raw
+    };
+    let source_url = url::Url::parse(source).ok()?;
+    let normalized = crate::repo_url::normalize_repo_url(source).ok()?;
+    let mut normalized = url::Url::parse(&normalized).ok()?;
+    if let Some(port) = source_url.port()
+        && !matches!((source_url.scheme(), port), ("ssh", 22) | ("git", 9418))
+    {
+        // set_port keeps distinct endpoints while removing HTTPS's default 443.
+        normalized.set_port(Some(port)).ok()?;
+    }
+    Some(normalized.to_string())
+}
