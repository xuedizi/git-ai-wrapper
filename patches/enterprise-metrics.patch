@@ -0,0 +1,166 @@
+use super::{
+    config, now,
+    sink::{Outcome, for_destination},
+    store,
+};
+use crate::metrics::db::MetricsDatabase;
+use serde_json::{Value, json};
+use std::collections::HashMap;
+use std::sync::{
+    OnceLock,
+    atomic::{AtomicBool, Ordering},
+};
+use std::time::{Duration, Instant};
+static STARTED: AtomicBool = AtomicBool::new(false);
+static RETRY: AtomicBool = AtomicBool::new(false);
+static WAKE: OnceLock<tokio::sync::Notify> = OnceLock::new();
+static WORKER_ERROR: std::sync::Mutex<Option<&'static str>> = std::sync::Mutex::new(None);
+fn notify() -> &'static tokio::sync::Notify {
+    WAKE.get_or_init(tokio::sync::Notify::new)
+}
+#[derive(Default)]
+struct State {
+    slots: HashMap<String, usize>,
+    destination: usize,
+    last_request: HashMap<String, Instant>,
+}
+/// All disk and HTTP work runs on the dedicated telemetry blocking pool.
+pub fn spawn() {
+    if STARTED.swap(true, Ordering::SeqCst) {
+        return;
+    }
+    config::reload();
+    crate::tokio_runtime::telemetry_runtime().spawn(async {
+        let mut state=State::default();
+        loop {
+            state=tokio::task::spawn_blocking(move || {
+                let result=tick(&mut state);
+                *WORKER_ERROR.lock().expect("worker error lock")=result.err().map(|_|"enterprise_worker_failed");
+                state
+            }).await.unwrap_or_default();
+            tokio::select! { _=tokio::time::sleep(Duration::from_secs(3))=>{}, _=notify().notified()=>{} }
+        }
+    });
+}
+fn with_db<T>(f: impl FnOnce(&mut rusqlite::Connection) -> store::Result<T>) -> store::Result<T> {
+    let mut db = MetricsDatabase::global()?
+        .lock()
+        .map_err(|_| crate::error::GitAiError::Generic("metrics database lock poisoned".into()))?;
+    f(db.enterprise_connection())
+}
+fn tick(state: &mut State) -> store::Result<()> {
+    config::reload();
+    // Retention remains active even if collection/upload is disabled.
+    with_db(|conn| store::expire(conn, now()))?;
+    let Some(cfg) = config::current() else {
+        return Ok(());
+    };
+    let credential_fingerprints: Vec<_> = cfg
+        .destinations
+        .iter()
+        .map(|d| (d.binding(), d.token().map(|v| config::digest(&v))))
+        .collect();
+    let fingerprint = config::digest(&serde_json::to_string(&(
+        cfg.as_ref(),
+        credential_fingerprints,
+    ))?);
+    with_db(|conn| store::refresh_configuration(conn, &fingerprint))?;
+    if RETRY.swap(false, Ordering::SeqCst) {
+        with_db(|conn| {
+            let tx = conn.transaction()?;
+            store::retry(&tx)?;
+            tx.commit()?;
+            Ok(())
+        })?;
+    }
+    with_db(|conn| store::project_pending(conn, &cfg, now()))?;
+    // Two requests at a time, four per tick. Network waits never hold the DB lock.
+    for _ in 0..2 {
+        std::thread::scope(|scope| -> store::Result<()> {
+            let mut uploads = Vec::new();
+            for _ in 0..2 {
+                let dest = &cfg.destinations[state.destination % cfg.destinations.len()];
+                state.destination = state.destination.wrapping_add(1);
+                let slot = state.slots.entry(dest.binding()).or_default();
+                let preferred = if (*slot).is_multiple_of(4) {
+                    "commit"
+                } else {
+                    "checkpoint"
+                };
+                *slot = slot.wrapping_add(1);
+                let alternate = if preferred == "commit" {
+                    "checkpoint"
+                } else {
+                    "commit"
+                };
+                let mut job = None;
+                for kind in [preferred, alternate] {
+                    job = with_db(|conn| {
+                        store::claim(conn, dest, &cfg.organization_id, kind, now())
+                    })?;
+                    if job.is_some() {
+                        break;
+                    }
+                }
+                let Some(job) = job else { continue };
+                let value: Value = serde_json::from_str(&job.payload)?;
+                let supported = dest
+                    .event_types
+                    .iter()
+                    .any(|t| Some(t.as_str()) == value["event_type"].as_str());
+                if !supported || matches!(dest.ack, config::Ack::Unconfirmed) {
+                    with_db(|conn| store::finish(conn, &job, &Outcome::ProtocolBlocked, now()))?;
+                    continue;
+                }
+                let interval = Duration::from_millis(dest.min_interval_ms);
+                if let Some(last) = state.last_request.get(&job.binding)
+                    && let Some(wait) = interval.checked_sub(last.elapsed())
+                {
+                    std::thread::sleep(wait);
+                }
+                state
+                    .last_request
+                    .insert(job.binding.clone(), Instant::now());
+                uploads.push(scope.spawn(move || {
+                    let outcome = for_destination(dest).deliver(&job.payload, &job.event_id);
+                    with_db(|conn| store::finish(conn, &job, &outcome, now())).map(|_| ())
+                }));
+            }
+            for upload in uploads {
+                upload.join().map_err(|_| {
+                    crate::error::GitAiError::Generic("enterprise upload task failed".into())
+                })??;
+            }
+            Ok(())
+        })?;
+    }
+    Ok(())
+}
+/// Run on a blocking pool from the daemon control API; commands never open an
+/// independent uploader or alter the original event identity.
+pub fn control(action: &str) -> store::Result<Value> {
+    match action {
+        "status" => {}
+        "flush" => {
+            notify().notify_one();
+        }
+        "retry" => {
+            RETRY.store(true, Ordering::SeqCst);
+            notify().notify_one();
+        }
+        _ => {
+            return Err(crate::error::GitAiError::Generic(
+                "expected telemetry status, flush or retry".into(),
+            ));
+        }
+    }
+    let mut value = with_db(|conn| store::status(conn, now()))?;
+    value["enabled"] = json!(config::current().is_some());
+    value["config_error"] = json!(config::last_error());
+    value["worker_error"] = json!(*WORKER_ERROR.lock().expect("worker error lock"));
+    value["upstream_metric_batches_dropped"] =
+        json!(crate::daemon::telemetry_worker::metric_batches_dropped());
+    value["requested_action"] = json!(action);
+    value["flush_is_async"] = json!(true);
+    Ok(value)
+}
