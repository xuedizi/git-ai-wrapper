+        "org",
+        "checkpoint",
+        now,
+    )
+    .unwrap()
+    .unwrap();
+    assert_ne!(
+        a.event_id, b.event_id,
+        "identical real edits must remain separate"
+    );
+    assert!(
+        store::claim(
+            db.enterprise_connection(),
+            &cfg.destinations[0],
+            "org",
+            "checkpoint",
