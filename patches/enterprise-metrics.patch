+use serde::{Deserialize, Serialize};
+#[derive(Clone, Serialize, Deserialize)]
+pub struct Event {
+    pub schema_version: u32,
+    pub event_id: String,
+    pub event_timestamp: String,
+    pub client_version: String,
+    pub organization_id: String,
+    pub user_id: String,
+    pub repo_id: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub tool: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub model: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub session_id: Option<String>,
+    #[serde(flatten)]
+    pub payload: Payload,
+}
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(tag = "event_type", rename_all = "snake_case")]
+pub enum Payload {
+    Checkpoint(Checkpoint),
+    Commit(Commit),
+}
+#[derive(Clone, Serialize, Deserialize)]
+pub struct Checkpoint {
+    pub kind: String,
+    pub measurement_mode: String,
+    pub lines_added: u32,
+    pub lines_deleted: u32,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub lines_added_sloc: Option<u32>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub lines_deleted_sloc: Option<u32>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub file_id: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub tool_use_id: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub trace_id: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub edit_kind: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub checkpoint_type: Option<String>,
+}
+#[derive(Clone, Serialize, Deserialize)]
+pub struct Commit {
+    pub commit_id: String,
+    pub committed_at: String,
+    pub git_diff_added_lines: u32,
+    pub git_diff_deleted_lines: u32,
+    pub ai_additions: u32,
+    pub human_additions: u32,
+    pub unknown_additions: u32,
+    pub tool_model_breakdown: Vec<Breakdown>,
+    pub is_rewrite: bool,
+    pub is_merge: bool,
+}
+#[derive(Clone, Serialize, Deserialize)]
+pub struct Breakdown {
+    pub tool: String,
+    pub model: String,
+    pub ai_additions: u32,
+}
