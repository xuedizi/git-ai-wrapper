diff --git a/src/commands/checkpoint_agent/presets/codebuddy.rs b/src/commands/checkpoint_agent/presets/codebuddy.rs
new file mode 100644
--- /dev/null
+++ b/src/commands/checkpoint_agent/presets/codebuddy.rs
@@ -0,0 +1,317 @@
+use super::parse;
+use super::{
+    AgentPreset, ParsedHookEvent, PostBashCall, PostFileEdit, PreBashCall, PreFileEdit,
+    PresetContext, StreamFormat, StreamSource,
+};
+use crate::authorship::authorship_log_serialization::generate_session_id;
+use crate::authorship::working_log::AgentId;
+use crate::commands::checkpoint_agent::bash_tool::{self, Agent, ToolClass};
+use crate::error::GitAiError;
+use crate::git::repository::validate_repository_path_no_git_exec;
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+
+pub struct CodebuddyPreset;
+
+fn validate_cwd(path: &Path) -> Result<(), String> {
+    if !path.is_absolute() {
+        return Err("not an absolute path".to_string());
+    }
+    if !path.is_dir() {
+        return Err("not an existing directory".to_string());
+    }
+    validate_repository_path_no_git_exec(path).map_err(|error| error.to_string())
+}
+
+// CodeBuddy CN IDE can send cwd="/" despite starting the hook in the project.
+// Preserve valid CLI event directories (including subdirectories); only then
+// fall back to the actual process cwd. Never use PWD or change the process cwd.
+fn resolve_cwd(data: &serde_json::Value) -> Result<PathBuf, GitAiError> {
+    let event_cwd = parse::optional_str(data, "cwd");
+    let event_error = match event_cwd {
+        Some(cwd) => match validate_cwd(Path::new(cwd)) {
+            Ok(()) => return Ok(PathBuf::from(cwd)),
+            Err(error) => error,
+        },
+        None => "missing or non-string cwd".to_string(),
+    };
+    let process_cwd = std::env::current_dir().map_err(|error| {
+        GitAiError::PresetError(format!(
+            "CodeBuddy cwd resolution failed: event cwd={event_cwd:?}: {event_error}; getcwd failed: {error}"
+        ))
+    })?;
+    if let Err(process_error) = validate_cwd(&process_cwd) {
+        return Err(GitAiError::PresetError(format!(
+            "CodeBuddy cwd resolution failed: event cwd={event_cwd:?}: {event_error}; getcwd={}: {process_error}; no directory selected",
+            process_cwd.display()
+        )));
+    }
+    tracing::warn!(
+        event_cwd = ?event_cwd,
+        process_cwd = %process_cwd.display(),
+        selected_cwd = %process_cwd.display(),
+        cwd_source = "getcwd",
+        reason = %event_error,
+        "CodeBuddy invalid event cwd; using hook process directory"
+    );
+    Ok(process_cwd)
+}
+
+impl AgentPreset for CodebuddyPreset {
+    fn parse(&self, hook_input: &str, trace_id: &str) -> Result<Vec<ParsedHookEvent>, GitAiError> {
+        let data: serde_json::Value = serde_json::from_str(hook_input)
+            .map_err(|e| GitAiError::PresetError(format!("Invalid JSON in hook_input: {}", e)))?;
+
+        // CodeBuddy tool names match Claude Code (Write/Edit/MultiEdit/Bash).
+        let tool_class = parse::optional_str_multi(&data, &["tool_name", "toolName"])
+            .map(|name| bash_tool::classify_tool(Agent::Codebuddy, name))
+            .unwrap_or(ToolClass::FileEdit);
+        if tool_class == ToolClass::Skip {
+            return Ok(Vec::new());
+        }
+
+        let resolved_cwd = resolve_cwd(&data)?;
+        let cwd = resolved_cwd.to_str().ok_or_else(|| {
+            GitAiError::PresetError("CodeBuddy getcwd is not valid UTF-8".to_string())
+        })?;
+        let transcript_path = parse::required_str(&data, "transcript_path")?;
+
+        // Session ID: prefer hook `session_id` / `sessionId`, fall back to the
+        // transcript filename stem (mirrors the Claude preset).
+        let session_id = parse::optional_str(&data, "session_id")
+            .or_else(|| parse::optional_str(&data, "sessionId"))
+            .map(|s| s.to_string())
+            .unwrap_or_else(|| {
+                parse::required_file_stem(&data, "transcript_path")
+                    .unwrap_or_else(|_| "unknown".to_string())
+            });
+
+        let hook_event = parse::optional_str_multi(&data, &["hook_event_name", "hookEventName"]);
+        let tool_use_id = parse::str_or_default_multi(&data, &["tool_use_id", "toolUseId"], "bash");
+
+        let is_bash = tool_class == ToolClass::Bash;
+
+        let context = PresetContext {
+            agent_id: AgentId {
+                tool: "codebuddy".to_string(),
+                id: session_id.clone(),
+                // Prefer an explicit hook model. For auto/missing models, retain
+                // the existing CLI transcript extraction before using the hook fallback.
+                model: parse::optional_str(&data, "model")
+                    .map(str::trim)
+                    .filter(|model| !model.is_empty())
+                    .filter(|model| *model != "auto")
+                    .map(str::to_owned)
+                    .or_else(|| {
+                        crate::streams::model_extraction::extract_model(
+                            Path::new(transcript_path),
+                            crate::streams::sweep::StreamFormat::CodebuddyJsonl,
+                            None,
+                        )
+                        .ok()
+                        .flatten()
+                    })
+                    .or_else(|| {
+                        parse::optional_str(&data, "model")
+                            .map(str::trim)
+                            .filter(|model| !model.is_empty())
+                            .map(str::to_owned)
+                    })
+                    .unwrap_or_else(|| "unknown".to_string()),
+            },
+            external_session_id: session_id.clone(),
+            trace_id: trace_id.to_string(),
+            cwd: PathBuf::from(cwd),
+            metadata: HashMap::from([("transcript_path".to_string(), transcript_path.to_string())]),
+        };
+
+        let transcript_path_buf = PathBuf::from(transcript_path);
+        // Subagent parent detection is intentionally not implemented in the
+        // first version; CodeBuddy transcripts are treated as top-level.
+        let stream_source = Some(StreamSource {
+            path: transcript_path_buf,
+            format: StreamFormat::CodebuddyJsonl,
+            session_id: generate_session_id(&session_id, "codebuddy"),
+            external_session_id: session_id.clone(),
+            external_parent_session_id: None,
+        });
+
+        let bash_command = parse::bash_command_from_hook_input(&data);
+        let event = match (hook_event, is_bash) {
+            (Some("PreToolUse"), true) => ParsedHookEvent::PreBashCall(PreBashCall {
+                context,
+                tool_use_id: tool_use_id.to_string(),
+                command: bash_command,
+            }),
+            (Some("PreToolUse"), false) => ParsedHookEvent::PreFileEdit(PreFileEdit {
+                context,
+                file_paths: parse::file_paths_from_tool_input(&data, cwd),
+                dirty_files: None,
+                tool_use_id: Some(tool_use_id.to_string()),
+            }),
+            (_, true) => ParsedHookEvent::PostBashCall(PostBashCall {
+                context,
+                tool_use_id: tool_use_id.to_string(),
+                command: bash_command,
+                stream_source,
+            }),
+            (_, false) => ParsedHookEvent::PostFileEdit(PostFileEdit {
+                context,
+                file_paths: parse::file_paths_from_tool_input(&data, cwd),
+                dirty_files: None,
+                stream_source,
+                tool_use_id: Some(tool_use_id.to_string()),
+            }),
+        };
+
+        Ok(vec![event])
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::commands::checkpoint_agent::presets::*;
+    use serde_json::json;
+
+    fn make_codebuddy_hook_input(event: &str, tool: &str) -> (tempfile::TempDir, String) {
+        let repo = tempfile::tempdir().unwrap();
+        assert!(
+            std::process::Command::new("git")
+                .args(["init", "--quiet"])
+                .arg(repo.path())
+                .status()
+                .unwrap()
+                .success()
+        );
+        let input = json!({
+            "transcript_path": "/home/user/.codebuddy/projects/proj/abc123.jsonl",
+            "cwd": repo.path(),
+            "hook_event_name": event,
+            "tool_name": tool,
+            "session_id": "sess-1",
+            "tool_use_id": "tu-1",
+            "tool_input": {"file_path": "src/main.rs"}
+        })
+        .to_string();
+        (repo, input)
+    }
+
+    #[test]
+    fn test_codebuddy_pre_file_edit() {
+        let (_repo, input) = make_codebuddy_hook_input("PreToolUse", "Write");
+        let events = CodebuddyPreset.parse(&input, "t_test123456789a").unwrap();
+        assert_eq!(events.len(), 1);
+        match &events[0] {
+            ParsedHookEvent::PreFileEdit(e) => {
+                assert_eq!(e.context.agent_id.tool, "codebuddy");
+                assert_eq!(e.context.external_session_id, "sess-1");
+                assert_eq!(e.file_paths, vec![_repo.path().join("src/main.rs")]);
+            }
+            _ => panic!("Expected PreFileEdit"),
+        }
+    }
+
+    #[test]
+    fn test_codebuddy_post_file_edit() {
+        let (_repo, input) = make_codebuddy_hook_input("PostToolUse", "Write");
+        let events = CodebuddyPreset.parse(&input, "t_test123456789a").unwrap();
+        match &events[0] {
+            ParsedHookEvent::PostFileEdit(e) => {
+                assert_eq!(e.context.agent_id.tool, "codebuddy");
+                let ts = e.stream_source.as_ref().expect("stream source present");
+                assert_eq!(ts.format, StreamFormat::CodebuddyJsonl);
+                assert_eq!(ts.session_id, generate_session_id("sess-1", "codebuddy"));
+            }
+            _ => panic!("Expected PostFileEdit"),
+        }
+    }
+
+    #[test]
+    fn test_codebuddy_ignores_read_only_tools() {
+        for tool_name in ["Read", "Glob", "Grep"] {
+            let (_repo, input) = make_codebuddy_hook_input("PostToolUse", tool_name);
+            let events = CodebuddyPreset.parse(&input, "t_test123456789a").unwrap();
+            assert!(
+                events.is_empty(),
+                "{tool_name} unexpectedly produced events"
+            );
+        }
+    }
+
+    #[test]
+    fn test_codebuddy_session_id_from_filename() {
+        let (repo, _) = make_codebuddy_hook_input("PostToolUse", "Write");
+        let input = json!({
+            "transcript_path": "/home/user/.codebuddy/projects/proj/9f8e7d6c-1234-abcd-5678-ef9012345678.jsonl",
+            "cwd": repo.path(),
+            "hook_event_name": "PostToolUse",
+            "tool_name": "Write",
+            "tool_input": {"file_path": "src/main.rs"}
+        })
+        .to_string();
+        let events = CodebuddyPreset.parse(&input, "t_test123456789a").unwrap();
+        match &events[0] {
+            ParsedHookEvent::PostFileEdit(e) => {
+                assert_eq!(
+                    e.context.external_session_id,
+                    "9f8e7d6c-1234-abcd-5678-ef9012345678"
+                );
+            }
+            _ => panic!("Expected PostFileEdit"),
+        }
+    }
+    #[test]
+    fn test_codebuddy_hook_model_priority_and_cli_fallback() {
+        let (repo, input) = make_codebuddy_hook_input("PostToolUse", "Write");
+        let mut input: serde_json::Value = serde_json::from_str(&input).unwrap();
+        let transcript = repo.path().join("session.jsonl");
+        input["transcript_path"] = json!(transcript);
+        for (hook, transcript_content, expected) in [
+            (
+                json!("glm-5.3"),
+                r#"{"providerData":{"model":"cli-model"}}"#,
+                "glm-5.3",
+            ),
+            (
+                json!("auto"),
+                r#"{"providerData":{"model":"glm-5.3"}}"#,
+                "glm-5.3",
+            ),
+            (json!("auto"), "", "auto"),
+            (json!("auto"), r#"{"messages":[],"requests":[]}"#, "auto"),
+            (
+                json!(null),
+                r#"{"providerData":{"model":"cli-model"}}"#,
+                "cli-model",
+            ),
+            (
+                json!(null),
+                r#"{"providerData":{"requestModelId":"cli-request-model"}}"#,
+                "cli-request-model",
+            ),
+            (
+                json!(""),
+                r#"{"providerData":{"model":"cli-model"}}"#,
+                "cli-model",
+            ),
+            (json!(null), "", "unknown"),
+            (json!("glm-5.3"), "", "glm-5.3"),
+        ] {
+            std::fs::write(&transcript, transcript_content).unwrap();
+            input["model"] = hook;
+            for event in ["PreToolUse", "PostToolUse"] {
+                input["hook_event_name"] = json!(event);
+                let events = CodebuddyPreset
+                    .parse(&input.to_string(), "t_model")
+                    .unwrap();
+                let model = match &events[0] {
+                    ParsedHookEvent::PreFileEdit(e) => &e.context.agent_id.model,
+                    ParsedHookEvent::PostFileEdit(e) => &e.context.agent_id.model,
+                    _ => panic!("unexpected event"),
+                };
+                assert_eq!(model, expected, "hook={} event={event}", input["model"]);
+            }
+        }
+    }
+}
