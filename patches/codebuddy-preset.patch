+use crate::repos::test_file::ExpectedLineExt;
+use crate::repos::test_repo::TestRepo;
+use git_ai::commands::checkpoint_agent::presets::{ParsedHookEvent, resolve_preset};
+use serde_json::{Value, json};
+use std::fs;
+use std::path::Path;
+use std::process::Command;
+
+// Run parsing in a child test process so cwd changes never race other tests.
+#[test]
+fn codebuddy_cwd_probe() {
+    let Ok(case) = std::env::var("CODEBUDDY_CWD_TEST_CASE") else {
+        return;
+    };
+    let case: Value = serde_json::from_str(&case).unwrap();
+    let expected = case["expected"].as_str();
+    for event in ["PreToolUse", "PostToolUse"] {
+        for tool in ["Write", "Bash"] {
+            let mut input = json!({
+                "transcript_path": "/unused/codebuddy.jsonl",
+                "session_id": "cwd-regression",
+                "hook_event_name": event,
+                "tool_name": tool,
+                "tool_input": {"file_path": "src/main.rs", "command": "echo test"}
+            });
+            if let Some(cwd) = case.get("cwd") {
+                input["cwd"] = cwd.clone();
+            }
+            let result = resolve_preset("codebuddy")
+                .unwrap()
+                .parse(&input.to_string(), "t_cwd");
+            let Some(expected) = expected else {
+                let error = result
+                    .expect_err("neither directory identifies a repository")
+                    .to_string();
+                assert!(error.contains("cwd"), "{error}");
+                assert!(error.contains("getcwd"), "{error}");
+                continue;
+            };
+            let events = result.unwrap();
+            assert_eq!(events.len(), 1);
+            let (context, paths) = match &events[0] {
+                ParsedHookEvent::PreFileEdit(e) => (&e.context, Some(&e.file_paths)),
+                ParsedHookEvent::PostFileEdit(e) => (&e.context, Some(&e.file_paths)),
+                ParsedHookEvent::PreBashCall(e) => (&e.context, None),
+                ParsedHookEvent::PostBashCall(e) => (&e.context, None),
+                _ => panic!("unexpected event"),
+            };
+            assert_eq!(context.cwd, Path::new(expected));
+            if let Some(paths) = paths {
+                assert_eq!(paths, &[Path::new(expected).join("src/main.rs")]);
+            }
+        }
+    }
+}
+
+fn probe(process_cwd: &Path, case: Value) {
+    let output = Command::new(std::env::current_exe().unwrap())
+        .args([
+            "--exact",
+            "codebuddy_cwd::codebuddy_cwd_probe",
+            "--nocapture",
+        ])
+        .current_dir(process_cwd)
+        .env("CODEBUDDY_CWD_TEST_CASE", case.to_string())
+        // These must not override either real cwd source.
+        .env("PWD", "/incorrect-pwd")
+        .env("CODEBUDDY_PROJECT_DIR", "/incorrect-project")
+        .env("CLAUDE_PROJECT_DIR", "/incorrect-project")
+        .output()
+        .unwrap();
+    assert!(
+        output.status.success(),
+        "{}\n{}",
+        String::from_utf8_lossy(&output.stdout),
+        String::from_utf8_lossy(&output.stderr)
+    );
+}
+
+fn init_repo(path: &Path) {
+    fs::create_dir_all(path).unwrap();
+    assert!(
+        Command::new("git")
+            .env(
+                "GIT_CONFIG_GLOBAL",
+                path.parent().unwrap().join("no-global-config")
+            )
+            .env("GIT_CONFIG_NOSYSTEM", "1")
+            .env_remove("GIT_TRACE2_EVENT")
+            .args(["-c", "init.defaultBranch=main", "init", "--quiet"])
+            .arg(path)
+            .status()
+            .unwrap()
+            .success()
+    );
+}
+
+#[test]
+fn codebuddy_cwd_cli_preserves_valid_event_directory() {
+    let tmp = tempfile::tempdir().unwrap();
+    let root = tmp.path().canonicalize().unwrap();
+    let event_repo = root.join("event repo");
+    let process_repo = root.join("process repo");
+    init_repo(&event_repo);
+    init_repo(&process_repo);
+    let sub = event_repo.join("nested dir");
+    fs::create_dir(&sub).unwrap();
+    probe(&process_repo, json!({"cwd": sub, "expected": sub}));
+    // A valid event must also work when the process cwd is not a repository.
+    probe(&root, json!({"cwd": sub, "expected": sub}));
+    assert!(!event_repo.join(".git/ai").exists());
+    assert!(!process_repo.join(".git/ai").exists());
+}
+
+#[test]
+fn codebuddy_cwd_ide_falls_back_for_invalid_event_directories() {
+    let tmp = tempfile::tempdir().unwrap();
+    let root = tmp.path().canonicalize().unwrap();
+    let repo = root.join("project with spaces");
+    init_repo(&repo);
+    let sub = repo.join("nested dir");
+    fs::create_dir(&sub).unwrap();
+    for cwd in [
+        json!("/"),
+        json!("relative"),
+        json!(""),
+        Value::Null,
+        json!(root),
+        json!(repo.join("missing")),
+        json!(42),
+    ] {
+        probe(&sub, json!({"cwd": cwd, "expected": sub}));
+    }
+    probe(&sub, json!({"expected": sub}));
+}
+
+#[test]
+fn codebuddy_cwd_rejects_when_both_sources_are_invalid() {
+    let tmp = tempfile::tempdir().unwrap();
+    probe(tmp.path(), json!({"cwd": "/", "expected": null}));
+    probe(tmp.path(), json!({"expected": null}));
+}
+
+#[test]
+fn codebuddy_cwd_falls_back_from_broken_git_pointer() {
+    let tmp = tempfile::tempdir().unwrap();
+    let root = tmp.path().canonicalize().unwrap();
+    let event_dir = root.join("broken worktree");
+    let process_repo = root.join("process");
+    fs::create_dir(&event_dir).unwrap();
+    init_repo(&process_repo);
+    fs::write(event_dir.join(".git"), "gitdir: ../missing-metadata\n").unwrap();
+    probe(
+        &process_repo,
+        json!({"cwd": event_dir, "expected": process_repo}),
+    );
+    fs::create_dir(root.join("missing-metadata")).unwrap();
+    probe(
+        &process_repo,
+        json!({"cwd": event_dir, "expected": process_repo}),
+    );
+}
+
+#[test]
+fn codebuddy_cwd_preserves_event_repo_with_unusable_ai_storage() {
+    let tmp = tempfile::tempdir().unwrap();
+    let root = tmp.path().canonicalize().unwrap();
+    let event_repo = root.join("event");
+    let process_repo = root.join("process");
+    init_repo(&event_repo);
+    init_repo(&process_repo);
+    fs::write(event_repo.join(".git/ai"), "blocked storage").unwrap();
+    probe(
+        &process_repo,
+        json!({"cwd": event_repo, "expected": event_repo}),
+    );
+    assert!(
+        !process_repo.join(".git/ai").exists(),
+        "discovery must not initialize storage"
+    );
+}
+
+#[test]
+fn codebuddy_cwd_fallback_records_committed_ai_lines() {
+    assert_fallback_records_committed_ai_lines("Write");
+}
+
+#[test]
+fn codebuddy_cwd_bash_fallback_records_committed_ai_lines() {
+    assert_fallback_records_committed_ai_lines("Bash");
+}
+
+fn assert_fallback_records_committed_ai_lines(tool: &str) {
+    let repo = TestRepo::new();
+    let file = repo.path().join("example.txt");
+    fs::write(&file, "original\n").unwrap();
+    repo.stage_all_and_commit("baseline").unwrap();
+    repo.filename("example.txt")
+        .assert_committed_lines(crate::lines!["original".unattributed_human()]);
+    let transcript = repo.path().join("session.jsonl");
+    fs::write(&transcript, "").unwrap();
+    let mut input = json!({
+        "cwd": "/", "session_id": "ide-cwd-regression", "model": "auto",
+        "transcript_path": transcript,
+        "hook_event_name": "PreToolUse", "tool_name": tool,
+        "tool_use_id": "write-1", "tool_input": {"file_path": "example.txt", "command": "echo AI addition >> example.txt"}
+    });
+    let checkpoint_output = repo
+        .git_ai_with_stdin(
+            &["checkpoint", "codebuddy", "--hook-input", "stdin"],
+            input.to_string().as_bytes(),
+        )
+        .unwrap();
+    assert!(
+        checkpoint_output.contains("checkpoint_requests="),
+        "{checkpoint_output}"
+    );
+    fs::write(&file, "original\nAI addition\n").unwrap();
+    input["hook_event_name"] = json!("PostToolUse");
+    let checkpoint_output = repo
+        .git_ai_with_stdin(
+            &["checkpoint", "codebuddy", "--hook-input", "stdin"],
+            input.to_string().as_bytes(),
+        )
+        .unwrap();
+    assert!(
+        checkpoint_output.contains("checkpoint_requests="),
+        "{checkpoint_output}"
+    );
+    let status: Value = serde_json::from_str(&repo.git_ai(&["status", "--json"]).unwrap()).unwrap();
+    assert!(status["stats"]["ai_additions"].as_u64().unwrap() > 0);
+    let commit = repo
+        .stage_all_and_commit("AI edit with IDE cwd fallback")
+        .unwrap();
+    repo.filename("example.txt")
+        .assert_committed_lines(crate::lines![
+            "original".unattributed_human(),
+            "AI addition".ai()
+        ]);
+    assert!(
+        commit
+            .authorship_log
+            .metadata
+            .sessions
+            .values()
+            .any(|s| s.agent_id.tool == "codebuddy")
+    );
+}
