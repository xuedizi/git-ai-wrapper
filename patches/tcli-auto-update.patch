@@ -0,0 +1,201 @@
+//! TCLI owns updates only for its bundled `.tcli/git-ai` installation.
+use std::ffi::OsStr;
+use std::path::{Path, PathBuf};
+use std::process::{Child, Command, Stdio};
+use std::sync::OnceLock;
+use std::time::{Duration, Instant};
+
+fn paired_tcli(executable: &Path) -> Option<PathBuf> {
+    let name = match executable.file_name()?.to_str()? {
+        "git-ai" => "tcli",
+        "git-ai.exe" => "tcli.exe",
+        _ => return None,
+    };
+    let sidecars = executable.parent()?;
+    (sidecars.file_name()? == ".tcli").then(|| sidecars.parent().map(|p| p.join(name)))?
+}
+
+fn installation() -> Option<&'static PathBuf> {
+    static TCLI: OnceLock<Option<PathBuf>> = OnceLock::new();
+    TCLI.get_or_init(|| std::env::current_exe().ok().and_then(|p| paired_tcli(&p)))
+        .as_ref()
+}
+
+pub(crate) fn is_managed() -> bool {
+    // Do not fall back to upstream downloads if the paired TCLI is temporarily absent.
+    installation().is_some()
+}
+
+fn enabled(value: Option<&OsStr>) -> bool {
+    value != Some(OsStr::new("0"))
+}
+
+fn next_check(now: Instant, startup: bool) -> Instant {
+    now + Duration::from_secs(if startup {
+        rand::random_range(60..=300)
+    } else {
+        3600
+    })
+}
+
+pub(crate) struct Scheduler {
+    executable: PathBuf,
+    next: Instant,
+    child: Option<Child>,
+}
+
+impl Scheduler {
+    pub(crate) fn new() -> Option<Self> {
+        let executable = installation()?.clone();
+        enabled(std::env::var_os("TCLI_AUTO_UPDATE").as_deref()).then(|| Self {
+            executable,
+            next: next_check(Instant::now(), true),
+            child: None,
+        })
+    }
+
+    pub(crate) fn remaining(&self) -> Duration {
+        self.next.saturating_duration_since(Instant::now())
+    }
+
+    pub(crate) fn tick(&mut self) {
+        let now = Instant::now();
+        if now < self.next {
+            return;
+        }
+        self.next = next_check(now, false);
+        if let Some(child) = &mut self.child {
+            match child.try_wait() {
+                Ok(None) => return,
+                Ok(Some(_)) => self.child = None,
+                Err(err) => {
+                    tracing::warn!(%err, "could not reap TCLI automatic update check");
+                    return;
+                }
+            }
+        }
+        let mut command = Command::new(&self.executable);
+        command
+            .args(["self-update", "--auto"])
+            .stdin(Stdio::null())
+            .stdout(Stdio::null())
+            .stderr(Stdio::null());
+        #[cfg(windows)]
+        {
+            use std::os::windows::process::CommandExt;
+            command.creation_flags(0x08000000); // CREATE_NO_WINDOW
+        }
+        match command.spawn() {
+            Ok(child) => self.child = Some(child),
+            Err(err) => tracing::warn!(%err, "could not start paired TCLI automatic update check"),
+        }
+        // Never wait here: the updater may request this daemon's shutdown.
+        // Dropping Child on shutdown leaves the independent updater running.
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn managed_layout_uses_paired_tcli() {
+        let root = std::env::temp_dir().join("tcli layout");
+        assert_eq!(
+            paired_tcli(&root.join(".tcli/git-ai")),
+            Some(root.join("tcli"))
+        );
+        assert_eq!(
+            paired_tcli(&root.join(".tcli/git-ai.exe")),
+            Some(root.join("tcli.exe"))
+        );
+    }
+
+    #[test]
+    fn standalone_layout_does_not_trigger_tcli() {
+        for path in ["/usr/local/bin/git-ai", "/tmp/.tcli/another", "/tmp/git-ai"] {
+            assert_eq!(paired_tcli(Path::new(path)), None);
+        }
+    }
+
+    #[test]
+    fn startup_is_jittered_and_retries_are_one_hour() {
+        let now = Instant::now();
+        for _ in 0..50 {
+            let delay = next_check(now, true).duration_since(now);
+            assert!((Duration::from_secs(60)..=Duration::from_secs(300)).contains(&delay));
+        }
+        assert_eq!(
+            next_check(now, false).duration_since(now),
+            Duration::from_secs(3600)
+        );
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn tick_spawns_silently_without_waiting_and_skips_early_or_overlapping_checks() {
+        use std::os::unix::fs::PermissionsExt;
+        let root = tempfile::tempdir().unwrap();
+        let executable = root.path().join("paired tcli");
+        std::fs::write(
+            &executable,
+            "#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$0.args\"\nsleep 0.2\n",
+        )
+        .unwrap();
+        std::fs::set_permissions(&executable, std::fs::Permissions::from_mode(0o700)).unwrap();
+        let mut scheduler = Scheduler {
+            executable: executable.clone(),
+            next: next_check(Instant::now(), true),
+            child: None,
+        };
+        scheduler.tick();
+        assert!(
+            scheduler.child.is_none(),
+            "startup must wait for its deadline"
+        );
+        scheduler.next = Instant::now();
+        scheduler.tick();
+        let pid = scheduler.child.as_ref().unwrap().id();
+        scheduler.next = Instant::now();
+        scheduler.tick();
+        assert_eq!(
+            scheduler.child.as_ref().unwrap().id(),
+            pid,
+            "do not overlap a running check"
+        );
+        let deadline = Instant::now() + Duration::from_secs(5);
+        while scheduler
+            .child
+            .as_mut()
+            .unwrap()
+            .try_wait()
+            .unwrap()
+            .is_none()
+        {
+            if Instant::now() >= deadline {
+                let child = scheduler.child.as_mut().unwrap();
+                let _ = child.kill();
+                let _ = child.wait();
+                panic!("synthetic TCLI did not exit within five seconds");
+            }
+            std::thread::sleep(Duration::from_millis(10));
+        }
+        assert_eq!(
+            std::fs::read_to_string(executable.with_file_name("paired tcli.args")).unwrap(),
+            "self-update\n--auto\n"
+        );
+        scheduler.tick();
+        assert_eq!(
+            scheduler.child.as_ref().unwrap().id(),
+            pid,
+            "completed check must still honor the next deadline"
+        );
+    }
+
+    #[test]
+    fn explicit_zero_disables_automatic_trigger() {
+        assert!(enabled(None));
+        assert!(enabled(Some(std::ffi::OsStr::new("1"))));
+        assert!(!enabled(Some(std::ffi::OsStr::new("0"))));
+    }
+}
