+/// Validate stored schemas without writing to installed data. SQLite may leave a
+/// WAL when process-global connections are not destructed. Recover such a journal
+/// only in a private disposable snapshot, preserving the original byte-for-byte.
+fn validate_database(path: &Path, expected: u32, stream_schema: bool) -> Result<(), GitAiError> {
+    if !path.exists() {
+        return Ok(());
+    }
+    verify_path(path)?;
+    let snapshot = tempfile::tempdir()?;
+    #[cfg(windows)]
+    platform::make_private(snapshot.path())?;
+    let copy = snapshot.path().join("validation.sqlite");
+    fs::copy(path, &copy)?;
+    for suffix in ["-wal", "-journal"] {
+        let sidecar = PathBuf::from(format!("{}{suffix}", path.display()));
+        match fs::symlink_metadata(&sidecar) {
+            Ok(_) => {
+                verify_path(&sidecar)?;
+                fs::copy(
+                    &sidecar,
+                    snapshot.path().join(format!("validation.sqlite{suffix}")),
+                )?;
+            }
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}
+            Err(e) => return Err(e.into()),
+        }
+    }
+    let connection = rusqlite::Connection::open_with_flags(
+        &copy,
+        rusqlite::OpenFlags::SQLITE_OPEN_READ_WRITE | rusqlite::OpenFlags::SQLITE_OPEN_NO_MUTEX,
+    )?;
+    let integrity: String = connection.query_row("PRAGMA quick_check(1)", [], |r| r.get(0))?;
+    if integrity != "ok" {
+        return Err(error(format!(
+            "database integrity check failed: {}",
+            path.display()
+        )));
+    }
+    let query = if stream_schema {
+        "SELECT CAST(MAX(version) AS INTEGER) FROM schema_version"
+    } else {
+        "SELECT CAST(value AS INTEGER) FROM schema_metadata WHERE key='version'"
+    };
+    let version: u32 = connection.query_row(query, [], |r| r.get(0))?;
+    if version != expected {
+        return Err(error(format!(
+            "database schema requires a separate migration: {} ({} != {})",
+            path.display(),
+            version,
+            expected
+        )));
+    }
+    Ok(())
+}
+pub(crate) fn offline_health(config: &DaemonConfig) -> Result<(), GitAiError> {
+    validate_database(
+        &crate::metrics::db::MetricsDatabase::database_path()?,
+        5,
+        false,
+    )?;
+    validate_database(&crate::notes::db::NotesDatabase::database_path()?, 1, false)?;
+    validate_database(
+        &crate::authorship::internal_db::InternalDatabase::database_path()?,
+        3,
+        false,
+    )?;
+    validate_database(&config.internal_dir.join("transcripts-db"), 4, true)?;
+    validate_database(&config.internal_dir.join("token-usage-db"), 2, true)
+}
