diff --git a/src/managed_update.rs b/src/managed_update.rs
new file mode 100644
index 0000000..1e9c44a
--- /dev/null
+++ b/src/managed_update.rs
@@ -0,0 +1,890 @@
+//! TCLI-owned update coordination. Disk access is confined to process/control entry points.
+use crate::daemon::{DaemonConfig, control_api::ControlRequest};
+use crate::error::GitAiError;
+use crate::utils::LockFile;
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use std::{
+    fs,
+    path::{Path, PathBuf},
+    sync::atomic::{AtomicBool, Ordering},
+    time::Duration,
+};
+
+static INSTALLATION: std::sync::OnceLock<PathBuf> = std::sync::OnceLock::new();
+pub(crate) fn installation() -> Result<PathBuf, GitAiError> {
+    match INSTALLATION.get() {
+        Some(path) => Ok(path.clone()),
+        None => Ok(fs::canonicalize(std::env::current_exe()?)?),
+    }
+}
+
+pub(crate) static PAUSED: AtomicBool = AtomicBool::new(false);
+static PRODUCERS: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+pub(crate) struct Producer;
+pub(crate) fn producer() -> Producer {
+    PRODUCERS.fetch_add(1, Ordering::AcqRel);
+    Producer
+}
+impl Drop for Producer {
+    fn drop(&mut self) {
+        PRODUCERS.fetch_sub(1, Ordering::AcqRel);
+    }
+}
+pub(crate) async fn drain_producers() {
+    while PRODUCERS.load(Ordering::Acquire) != 0 {
+        tokio::time::sleep(Duration::from_millis(1)).await;
+    }
+}
+static DATA_FAILED: AtomicBool = AtomicBool::new(false);
+pub(crate) fn record_data_failure() {
+    if managed() {
+        DATA_FAILED.store(true, Ordering::Release);
+    }
+}
+pub(crate) fn data_failed() -> bool {
+    DATA_FAILED.load(Ordering::Acquire)
+}
+pub(crate) static VALIDATING: AtomicBool = AtomicBool::new(false);
+pub(crate) fn managed() -> bool {
+    option_env!("TCLI_MANAGED_GIT_AI") == Some("1") || wrapper_version() != "development"
+}
+pub(crate) fn wrapper_version() -> &'static str {
+    crate::enterprise_metrics::embedded::WRAPPER_VERSION
+}
+fn error(message: impl Into<String>) -> GitAiError {
+    GitAiError::Generic(message.into())
+}
+fn invocation_owns_installation(target: &Path) -> Result<bool, GitAiError> {
+    let current = fs::canonicalize(std::env::current_exe()?)?;
+    if current == target {
+        return Ok(true);
+    }
+    let parent = target
+        .parent()
+        .ok_or_else(|| error("installation has no parent"))?;
+    // Staged bridge copies live only below the same protected installation directory.
+    Ok(current.starts_with(parent.join("update"))
+        || current.starts_with(parent.join(".tcli").join("update")))
+}
+fn set_installation(path: &str) -> Result<(), GitAiError> {
+    let path = PathBuf::from(path);
+    if !path.is_absolute()
+        || path
+            .components()
+            .any(|p| matches!(p, std::path::Component::ParentDir))
+    {
+        return Err(error("installation must be an absolute normalized path"));
+    }
+    let parent = path
+        .parent()
+        .ok_or_else(|| error("installation has no parent"))?;
+    verify_path(parent)?;
+    if fs::symlink_metadata(&path).is_ok() {
+        verify_path(&path)?;
+    }
+    let path = fs::canonicalize(parent)?.join(
+        path.file_name()
+            .ok_or_else(|| error("installation has no filename"))?,
+    );
+    if !invocation_owns_installation(&path)? {
+        return Err(error(
+            "bridge is outside the controlled installation or staging directory",
+        ));
+    }
+    INSTALLATION
+        .set(path)
+        .map_err(|_| error("installation already selected"))
+}
+// One installed binary owns one immutable runtime namespace, including data homes.
+// Keeping the binding beside the installation makes HOME overrides observable.
+fn normalized(path: &Path) -> Result<PathBuf, GitAiError> {
+    if !path.is_absolute()
+        || path
+            .components()
+            .any(|c| matches!(c, std::path::Component::ParentDir))
+    {
+        return Err(error("runtime binding requires absolute normalized paths"));
+    }
+    if path.exists() {
+        return Ok(fs::canonicalize(path)?);
+    }
+    let parent = path
+        .parent()
+        .ok_or_else(|| error("runtime binding path has no parent"))?;
+    Ok(normalized(parent)?.join(
+        path.file_name()
+            .ok_or_else(|| error("runtime binding path has no name"))?,
+    ))
+}
+fn runtime_identity(config: &DaemonConfig) -> Result<Value, GitAiError> {
+    Ok(json!({"protocol":1,"installation":installation()?,
+        "home":normalized(&config.internal_dir)?, "lock":normalized(&config.lock_path)?,
+        "control":config.control_socket_path, "trace":config.trace_socket_path,
+        "metrics":normalized(&crate::metrics::db::MetricsDatabase::database_path()?)?,
+        "notes":normalized(&crate::notes::db::NotesDatabase::database_path()?)?,
+        "authorship":normalized(&crate::authorship::internal_db::InternalDatabase::database_path()?)?}))
+}
+fn runtime_binding(config: &DaemonConfig, create: bool) -> Result<(), GitAiError> {
+    let executable = installation()?;
+    let parent = executable
+        .parent()
+        .ok_or_else(|| error("runtime binding installation has no parent"))?;
+    let dir = parent.join(".git-ai-runtime");
+    let path = dir.join("binding.json");
+    let expected = runtime_identity(config)?;
+    let check = || -> Result<(), GitAiError> {
+        verify_path(&dir)?;
+        verify_path(&path)?;
+        #[cfg(windows)]
+        {
+            platform::verify_private(&dir)?;
+            platform::verify_private(&path)?;
+        }
+        let actual: Value = serde_json::from_slice(&fs::read(&path)?)?;
+        if actual != expected {
+            return Err(error(
+                "runtime binding mismatch: this installation already owns another runtime/data home",
+            ));
+        }
+        Ok(())
+    };
+    if fs::symlink_metadata(&path).is_ok() {
+        return check();
+    }
+    if !create {
+        // An incomplete durable binding is never treated as an unbound installation.
+        if fs::symlink_metadata(&dir).is_ok() {
+            return Err(error("runtime binding is incomplete; recover installation"));
+        }
+        return Ok(());
+    }
+    verify_path(parent)?;
+    private_directory(&dir)?;
+    let lock_path = dir.join("binding.lock");
+    if lock_path.exists() {
+        verify_path(&lock_path)?;
+    }
+    let deadline = std::time::Instant::now() + Duration::from_secs(2);
+    let _lock = loop {
+        if let Some(lock) = LockFile::try_acquire(&lock_path) {
+            break lock;
+        }
+        if std::time::Instant::now() >= deadline {
+            return Err(error("runtime binding is busy"));
+        }
+        std::thread::sleep(Duration::from_millis(10));
+    };
+    if fs::symlink_metadata(&path).is_ok() {
+        return check();
+    }
+    use std::io::Write;
+    let temporary = dir.join(format!("binding-{}.tmp", crate::uuid::generate_v4()));
+    let mut options = fs::OpenOptions::new();
+    options.create_new(true).write(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.mode(0o600);
+    }
+    let mut file = options.open(&temporary)?;
+    #[cfg(windows)]
+    platform::make_private(&temporary)?;
+    file.write_all(&serde_json::to_vec(&expected)?)?;
+    file.sync_all()?;
+    drop(file);
+    #[cfg(not(windows))]
+    fs::rename(&temporary, &path)?;
+    #[cfg(windows)]
+    platform::replace(&temporary, &path)?;
+    sync_directory(&dir)?;
+    sync_directory(parent)
+}
+fn valid_transaction(value: &str) -> bool {
+    value.len() == 36
+        && value.bytes().enumerate().all(|(i, b)| {
+            if [8, 13, 18, 23].contains(&i) {
+                b == b'-'
+            } else {
+                b.is_ascii_hexdigit()
+            }
+        })
+}
+#[derive(Clone, Serialize, Deserialize)]
+pub(crate) struct Maintenance {
+    pub transaction: String,
+    pub executable: PathBuf,
+    pub phase: String,
+}
+fn directory(config: &DaemonConfig) -> PathBuf {
+    config.internal_dir.join("managed-update")
+}
+fn state_path(config: &DaemonConfig) -> PathBuf {
+    directory(config).join("state.json")
+}
+
+fn verify_path(path: &Path) -> Result<(), GitAiError> {
+    let metadata = fs::symlink_metadata(path)?;
+    if metadata.file_type().is_symlink() {
+        return Err(error("managed update rejects symlinks"));
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        if metadata.uid() != unsafe { libc::geteuid() } || metadata.mode() & 0o022 != 0 {
+            return Err(error(
+                "managed update requires current-user ownership and no group/other writes",
+            ));
+        }
+    }
+    #[cfg(windows)]
+    {
+        use std::os::windows::fs::MetadataExt;
+        if metadata.file_attributes() & 0x400 != 0 {
+            return Err(error("managed update rejects reparse points"));
+        }
+        // Windows ownership/DACL verification is implemented by the platform helper.
+        platform::verify_owner(path)?;
+    }
+    Ok(())
+}
+fn ensure_directory(config: &DaemonConfig) -> Result<(), GitAiError> {
+    fs::create_dir_all(&config.internal_dir)?;
+    verify_path(&config.internal_dir)?;
+    private_directory(&directory(config))
+}
+fn private_directory(dir: &Path) -> Result<(), GitAiError> {
+    match fs::create_dir(dir) {
+        Ok(()) => {
+            #[cfg(unix)]
+            {
+                use std::os::unix::fs::PermissionsExt;
+                fs::set_permissions(dir, fs::Permissions::from_mode(0o700))?;
+            }
+            #[cfg(windows)]
+            platform::make_private(dir)?;
+        }
+        Err(e) if e.kind() == std::io::ErrorKind::AlreadyExists => {}
+        Err(e) => return Err(e.into()),
+    }
+    verify_path(dir)?;
+    #[cfg(windows)]
+    platform::verify_private(dir)?;
+    Ok(())
+}
+pub(crate) fn gate(config: &DaemonConfig) -> Result<LockFile, GitAiError> {
+    ensure_directory(config)?;
+    let path = directory(config).join("gate.lock");
+    if fs::symlink_metadata(&path).is_ok() {
+        verify_path(&path)?;
+    }
+    let deadline = std::time::Instant::now() + Duration::from_secs(2);
+    loop {
+        if let Some(lock) = LockFile::try_acquire(&path) {
+            return Ok(lock);
+        }
+        if std::time::Instant::now() >= deadline {
+            return Err(error("managed update runtime gate is busy"));
+        }
+        std::thread::sleep(Duration::from_millis(10));
+    }
+}
+pub(crate) fn read(config: &DaemonConfig) -> Result<Option<Maintenance>, GitAiError> {
+    let path = state_path(config);
+    match fs::symlink_metadata(&path) {
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+        Err(e) => return Err(e.into()),
+        Ok(_) => {}
+    }
+    verify_path(&directory(config))?;
+    verify_path(&path)?;
+    #[cfg(windows)]
+    {
+        platform::verify_private(&directory(config))?;
+        platform::verify_private(&path)?;
+    }
+    let state: Maintenance = serde_json::from_slice(&fs::read(&path)?)?;
+    if !valid_transaction(&state.transaction) {
+        return Err(error("invalid durable maintenance transaction"));
+    }
+    Ok(Some(state))
+}
+fn sync_directory(path: &Path) -> Result<(), GitAiError> {
+    #[cfg(unix)]
+    fs::File::open(path)?.sync_all()?;
+    #[cfg(windows)]
+    {
+        let _ = path;
+    }
+    Ok(())
+}
+pub(crate) fn write(config: &DaemonConfig, state: &Maintenance) -> Result<(), GitAiError> {
+    use std::io::Write;
+    let path = directory(config).join(format!("state-{}.tmp", crate::uuid::generate_v4()));
+    let mut options = fs::OpenOptions::new();
+    options.create_new(true).write(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.mode(0o600);
+    }
+    let mut file = options.open(&path)?;
+    #[cfg(windows)]
+    platform::make_private(&path)?;
+    file.write_all(&serde_json::to_vec(state)?)?;
+    file.sync_all()?;
+    drop(file);
+    #[cfg(not(windows))]
+    fs::rename(&path, state_path(config))?;
+    #[cfg(windows)]
+    platform::replace(&path, &state_path(config))?;
+    sync_directory(&directory(config))
+}
+pub(crate) fn clear(config: &DaemonConfig) -> Result<(), GitAiError> {
+    match fs::remove_file(state_path(config)) {
+        Ok(()) => {}
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}
+        Err(e) => return Err(e.into()),
+    }
+    sync_directory(&directory(config))
+}
+pub(crate) fn owned(config: &DaemonConfig, transaction: &str) -> Result<Maintenance, GitAiError> {
+    let state = read(config)?.ok_or_else(|| error("no managed update transaction"))?;
+    if !valid_transaction(transaction)
+        || state.transaction != transaction
+        || !invocation_owns_installation(&state.executable)?
+    {
+        return Err(error(
+            "managed update transaction or executable ownership mismatch",
+        ));
+    }
+    Ok(state)
+}
+pub(crate) fn startup_guard(
+    config: &DaemonConfig,
+    transaction: Option<&str>,
+) -> Result<Option<LockFile>, GitAiError> {
+    if !managed() {
+        return Ok(None);
+    }
+    runtime_binding(config, true)?;
+    let guard = gate(config)?;
+    if let Some(state) = read(config)? {
+        if transaction != Some(&state.transaction) || state.phase != "validating" {
+            return Err(error("git-ai maintenance active; startup deferred"));
+        }
+        owned(config, &state.transaction)?;
+        VALIDATING.store(true, Ordering::Release);
+    } else if transaction.is_some() {
+        return Err(error("validation requires a durable transaction"));
+    }
+    Ok(Some(guard))
+}
+
+pub(crate) struct ForegroundLease {
+    lock: Option<LockFile>,
+    path: PathBuf,
+}
+impl Drop for ForegroundLease {
+    fn drop(&mut self) {
+        drop(self.lock.take());
+        let _ = fs::remove_file(&self.path);
+    }
+}
+pub(crate) fn foreground(config: &DaemonConfig) -> Result<Option<ForegroundLease>, GitAiError> {
+    if !managed() {
+        return Ok(None);
+    }
+    runtime_binding(config, true)?;
+    let _gate = gate(config)?;
+    if read(config)?.is_some() {
+        return Err(error("git-ai maintenance active; command deferred"));
+    }
+    let path = directory(config).join(format!("foreground-{}.lock", crate::uuid::generate_v4()));
+    let lock = LockFile::try_acquire(&path)
+        .ok_or_else(|| error("cannot register managed foreground command"))?;
+    Ok(Some(ForegroundLease {
+        lock: Some(lock),
+        path,
+    }))
+}
+pub(crate) fn foreground_watermark(config: &DaemonConfig) -> u64 {
+    fs::metadata(directory(config))
+        .and_then(|m| m.modified())
+        .ok()
+        .and_then(|t| t.duration_since(std::time::UNIX_EPOCH).ok())
+        .map(|d| d.as_nanos() as u64)
+        .unwrap_or(0)
+}
+pub(crate) fn foreground_in_use(config: &DaemonConfig) -> Result<bool, GitAiError> {
+    let entries = match fs::read_dir(directory(config)) {
+        Ok(entries) => entries,
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(false),
+        Err(e) => return Err(e.into()),
+    };
+    for entry in entries {
+        let path = entry?.path();
+        if !path
+            .file_name()
+            .unwrap_or_default()
+            .to_string_lossy()
+            .starts_with("foreground-")
+        {
+            continue;
+        }
+        let mut options = fs::OpenOptions::new();
+        options.read(true).write(true);
+        #[cfg(windows)]
+        {
+            use std::os::windows::fs::OpenOptionsExt;
+            options.share_mode(0);
+        }
+        let file = match options.open(&path) {
+            Ok(file) => file,
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => continue,
+            Err(_) => return Ok(true),
+        };
+        #[cfg(unix)]
+        {
+            use std::os::fd::AsRawFd;
+            if unsafe { libc::flock(file.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) } != 0 {
+                return Ok(true);
+            }
+        }
+        drop(file);
+    }
+    Ok(false)
+}
+fn foreground_busy(config: &DaemonConfig) -> Result<bool, GitAiError> {
+    for entry in fs::read_dir(directory(config))? {
+        let path = entry?.path();
+        if !path
+            .file_name()
+            .unwrap_or_default()
+            .to_string_lossy()
+            .starts_with("foreground-")
+        {
+            continue;
+        }
+        verify_path(&path)?;
+        let Some(lock) = LockFile::try_acquire(&path) else {
+            return Ok(true);
+        };
+        drop(lock);
+        fs::remove_file(path)?;
+    }
+    Ok(false)
+}
+fn local_status(config: &DaemonConfig) -> Result<Value, GitAiError> {
+    offline_health(config)?;
+    let state = read(config)?;
+    Ok(
+        json!({"protocol":1,"wrapper_version":wrapper_version(),"transaction":state.as_ref().map(|s|&s.transaction),
+        "running":false,"pid":null,"executable":installation()?,"daemon_home":config.internal_dir,
+        "busy":false,"idle_seconds":0,"phase":state.as_ref().map(|s|s.phase.as_str()).unwrap_or("normal"),
+        "ready":true,"quiesced":true,"durable":true,"data_schema":1,"data_schema_min":1,"data_schema_max":1}),
+    )
+}
+fn request(config: &DaemonConfig, action: &str, transaction: &str) -> Result<Value, GitAiError> {
+    let response = crate::daemon::send_control_request(
+        &config.control_socket_path,
+        &ControlRequest::ManagedUpdate {
+            action: action.into(),
+            transaction: transaction.into(),
+        },
+    )?;
+    if !response.ok {
+        return Err(error(
+            response
+                .error
+                .unwrap_or_else(|| "managed control failed".into()),
+        ));
+    }
+    response
+        .data
+        .ok_or_else(|| error("managed control returned no identity"))
+}
+pub(crate) fn inspect(config: &DaemonConfig) -> Result<Value, GitAiError> {
+    runtime_binding(config, false)?;
+    if crate::commands::daemon::daemon_is_up(config) {
+        let response = crate::daemon::send_control_request(
+            &config.control_socket_path,
+            &ControlRequest::ManagedInspect,
+        )?;
+        if !response.ok {
+            return Err(error("running daemon lacks managed update protocol"));
+        }
+        let status = response
+            .data
+            .ok_or_else(|| error("daemon returned no managed identity"))?;
+        let reported = status["daemon_home"]
+            .as_str()
+            .ok_or_else(|| error("daemon did not report runtime identity"))?;
+        if fs::canonicalize(reported)? != fs::canonicalize(&config.internal_dir)? {
+            return Err(error(
+                "daemon control endpoint belongs to a different runtime",
+            ));
+        }
+        if status["executable"].as_str() != installation()?.to_str() {
+            return Err(error(
+                "daemon belongs to a different installation; refusing maintenance",
+            ));
+        }
+        Ok(status)
+    } else {
+        // A missing socket is not process-exit evidence. A live lifecycle lock blocks mutation.
+        if config.lock_path.exists() && LockFile::try_acquire(&config.lock_path).is_none() {
+            return Err(error(
+                "daemon lifecycle lock held but control endpoint unavailable",
+            ));
+        }
+        local_status(config)
+    }
+}
+pub(crate) fn execute(
+    config: &DaemonConfig,
+    action: &str,
+    transaction: &str,
+) -> Result<Value, GitAiError> {
+    if !managed() {
+        return Err(error(
+            "managed-update is available only in TCLI-managed builds",
+        ));
+    }
+    if action == "inspect" {
+        return inspect(config);
+    }
+    if !valid_transaction(transaction) {
+        return Err(error("--transaction must be a UUID"));
+    }
+    inspect(config)?;
+    runtime_binding(config, true)?;
+    let _gate = gate(config)?;
+    let before = inspect(config)?;
+    let running = before["running"].as_bool() == Some(true);
+    if running && before["executable"].as_str() != installation()?.to_str() {
+        return Err(error(
+            "daemon belongs to a different installation; refusing maintenance",
+        ));
+    }
+    match action {
+        "prepare" => {
+            if let Some(state) = read(config)? {
+                owned(config, transaction)?;
+                if state.phase != "prepared" {
+                    return Err(error("transaction already stopping or validating"));
+                }
+            }
+            if foreground_busy(config)? {
+                return Err(error("busy: foreground git-ai commands remain"));
+            }
+            let state = Maintenance {
+                transaction: transaction.into(),
+                executable: installation()?,
+                phase: "prepared".into(),
+            };
+            write(config, &state)?;
+            if running {
+                request(config, action, transaction)
+            } else {
+                local_status(config)
+            }
+        }
+        "abort" => {
+            if read(config)?.is_none() {
+                return inspect(config);
+            }
+            let state = owned(config, transaction)?;
+            if state.phase != "prepared" {
+                return Err(error("cannot abort after stop; recover transaction"));
+            }
+            if running {
+                request(config, action, transaction)?;
+            }
+            clear(config)?;
+            inspect(config)
+        }
+        "stop" => {
+            owned(config, transaction)?;
+            if running {
+                request(config, action, transaction)
+            } else {
+                let mut state = owned(config, transaction)?;
+                state.phase = "stopping".into();
+                write(config, &state)?;
+                local_status(config)
+            }
+        }
+        "start" => {
+            let mut state = owned(config, transaction)?;
+            if running {
+                return Err(error(
+                    "daemon still running; independently confirm process exit before start",
+                ));
+            }
+            state.phase = "validating".into();
+            write(config, &state)?;
+            crate::commands::daemon::spawn_managed_validation(config, transaction)
+                .map_err(error)?;
+            drop(_gate);
+            let deadline = std::time::Instant::now() + Duration::from_secs(15);
+            loop {
+                if crate::commands::daemon::daemon_is_up(config) {
+                    return request(config, "health", transaction);
+                }
+                if std::time::Instant::now() >= deadline {
+                    return Err(error("validation startup timed out"));
+                }
+                std::thread::sleep(Duration::from_millis(25));
+            }
+        }
+        "health" => {
+            owned(config, transaction)?;
+            if running {
+                request(config, action, transaction)
+            } else {
+                local_status(config)
+            }
+        }
+        "resume" => {
+            if read(config)?.is_none() {
+                return inspect(config);
+            }
+            owned(config, transaction)?;
+            if running {
+                request(config, action, transaction)?;
+            }
+            clear(config)?;
+            inspect(config)
+        }
+        _ => Err(error("unknown managed-update action")),
+    }
+}
+pub(crate) fn handle(args: &[String]) {
+    let action = args.first().map(String::as_str).unwrap_or("");
+    if action == "identity" {
+        println!(
+            "{}",
+            json!({"protocol":1,"wrapper_version":wrapper_version(),"managed":managed(),
+            "data_schema":1,"data_schema_min":1,"data_schema_max":1})
+        );
+        return;
+    }
+    let result = (|| {
+        let mut transaction = "";
+        let mut i = 1;
+        while i < args.len() {
+            let value = args
+                .get(i + 1)
+                .ok_or_else(|| error("missing managed-update option value"))?;
+            match args[i].as_str() {
+                "--transaction" if transaction.is_empty() => transaction = value,
+                "--installation" => set_installation(value)?,
+                _ => return Err(error("unknown or repeated managed-update option")),
+            }
+            i += 2;
+        }
+        let config = DaemonConfig::from_env_or_default_paths()?;
+        execute(&config, action, transaction)
+    })();
+    match result {
+        Ok(value) => println!("{value}"),
+        Err(e) => {
+            println!(
+                "{}",
+                json!({"protocol":1,"wrapper_version":wrapper_version(),"error":e.to_string(),"ready":false,"durable":false,"quiesced":false})
+            );
+            std::process::exit(1);
+        }
+    }
+}
+pub(crate) async fn wait_for_resume() {
+    while VALIDATING.load(Ordering::Acquire) {
+        tokio::time::sleep(Duration::from_millis(25)).await;
+    }
+}
+pub(crate) fn trigger_check() {
+    let Ok(exe) = std::env::current_exe() else {
+        return;
+    };
+    let Some(root) = exe.parent().and_then(Path::parent) else {
+        return;
+    };
+    if exe
+        .parent()
+        .and_then(Path::file_name)
+        .and_then(|n| n.to_str())
+        != Some(".tcli")
+    {
+        return;
+    }
+    let checker = root.join(if cfg!(windows) { "tcli.exe" } else { "tcli" });
+    if !checker.is_file() {
+        return;
+    }
+    let mut command = std::process::Command::new(&checker);
+    command
+        .args(["_update-check", "--source", "daemon", "--install"])
+        .arg(&checker)
+        .stdin(std::process::Stdio::null())
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null());
+    #[cfg(windows)]
+    {
+        use std::os::windows::process::CommandExt;
+        command.creation_flags(crate::utils::CREATE_NO_WINDOW);
+    }
+    if let Ok(mut child) = command.spawn() {
+        let _ = std::thread::spawn(move || child.wait());
+    }
+}
