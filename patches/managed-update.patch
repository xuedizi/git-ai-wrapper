+#[test]
+fn managed_update_binding_rejects_changed_home_even_when_daemon_stopped() {
+    let repo = TestRepo::new_with_daemon_scope(DaemonTestScope::NoDaemon);
+    let token = git_ai::uuid::generate_v4();
+    bridge(&repo, "prepare", &token).unwrap();
+    bridge(&repo, "abort", &token).unwrap();
+    let alternative = tempfile::tempdir().unwrap();
+    for action in ["inspect", "prepare"] {
+        let output = command(&repo, &["managed-update", action, "--transaction", &token])
+            .env("GIT_AI_DAEMON_HOME", alternative.path())
+            .output()
+            .unwrap();
+        assert!(
+            !output.status.success(),
+            "{action} missed installation binding"
+        );
+        assert!(String::from_utf8_lossy(&output.stdout).contains("runtime binding"));
+    }
+    let startup = command(&repo, &["bg", "run"])
+        .env("GIT_AI_DAEMON_HOME", alternative.path())
+        .output()
+        .unwrap();
+    assert!(!startup.status.success());
+    assert!(String::from_utf8_lossy(&startup.stderr).contains("runtime binding"));
+    let home_only = command(&repo, &["managed-update", "inspect"])
+        .env("HOME", alternative.path())
+        .output()
+        .unwrap();
+    assert!(
+        !home_only.status.success(),
+        "same runtime with a different data HOME must fail closed"
+    );
+    let output = command(&repo, &["status"])
+        .env("HOME", alternative.path())
+        .env("GIT_AI_DAEMON_HOME", alternative.path())
+        .output()
+        .unwrap();
+    assert_eq!(output.status.code(), Some(75));
+    assert!(
+        !alternative
+            .path()
+            .join(".git-ai/internal/managed-update")
+            .exists()
+    );
+}
+#[test]
+fn managed_update_stopped_health_rejects_corrupt_database_without_writing() {
+    let repo = TestRepo::new_with_daemon_scope(DaemonTestScope::NoDaemon);
+    let token = git_ai::uuid::generate_v4();
+    bridge(&repo, "prepare", &token).unwrap();
+    let path = repo
+        .test_home_path()
+        .join(".git-ai/internal/transcripts-db");
+    std::fs::write(&path, b"corrupt database").unwrap();
+    let original = std::fs::read(&path).unwrap();
+    assert!(bridge(&repo, "health", &token).is_err());
+    assert_eq!(std::fs::read(&path).unwrap(), original);
+    assert!(!path.with_file_name("transcripts-db-wal").exists());
+}
