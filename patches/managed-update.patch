diff --git a/tests/integration/managed_update.rs b/tests/integration/managed_update.rs
new file mode 100644
index 0000000..4aeab18
--- /dev/null
+++ b/tests/integration/managed_update.rs
@@ -0,0 +1,338 @@
+use crate::repos::test_repo::{DaemonTestScope, TestRepo};
+use serde_json::Value;
+use std::{
+    process::{Child, Stdio},
+    time::{Duration, Instant},
+};
+struct ProcessGuard(Child);
+impl Drop for ProcessGuard {
+    fn drop(&mut self) {
+        let _ = self.0.kill();
+        let _ = self.0.wait();
+    }
+}
+fn command(repo: &TestRepo, args: &[&str]) -> std::process::Command {
+    let original = repo.git_ai_command_without_pre_sync_for_test(args, &[]);
+    let dir = repo.test_home_path().join(".tcli");
+    std::fs::create_dir_all(&dir).unwrap();
+    let binary = dir.join(if cfg!(windows) {
+        "git-ai.exe"
+    } else {
+        "git-ai"
+    });
+    if !binary.exists() {
+        std::fs::copy(original.get_program(), &binary).unwrap();
+    }
+    let mut cmd = std::process::Command::new(binary);
+    cmd.args(original.get_args());
+    for (key, value) in original.get_envs() {
+        if let Some(value) = value {
+            cmd.env(key, value);
+        } else {
+            cmd.env_remove(key);
+        }
+    }
+    if let Some(dir) = original.get_current_dir() {
+        cmd.current_dir(dir);
+    }
+    cmd
+}
+fn run(repo: &TestRepo, args: &[&str]) -> Result<String, String> {
+    let output = command(repo, args).output().unwrap();
+    if output.status.success() {
+        Ok(String::from_utf8_lossy(&output.stdout).into_owned())
+    } else {
+        Err(String::from_utf8_lossy(&output.stderr).into_owned())
+    }
+}
+fn bridge(repo: &TestRepo, action: &str, token: &str) -> Result<Value, String> {
+    let output = command(repo, &["managed-update", action, "--transaction", token])
+        .output()
+        .unwrap();
+    let value: Value = serde_json::from_slice(&output.stdout).unwrap_or_else(|_| {
+        panic!(
+            "invalid bridge JSON: stdout={} stderr={}",
+            String::from_utf8_lossy(&output.stdout),
+            String::from_utf8_lossy(&output.stderr)
+        )
+    });
+    if output.status.success() {
+        Ok(value)
+    } else {
+        Err(value.to_string())
+    }
+}
+fn traced_git(repo: &TestRepo, args: &[&str]) -> Result<String, String> {
+    let config = git_ai::daemon::DaemonConfig::from_home(repo.test_home_path());
+    repo.git_with_env(
+        args,
+        &[
+            ("GIT_TRACE2_EVENT", config.trace2_event_target().as_str()),
+            ("GIT_TRACE2_EVENT_NESTING", "0"),
+        ],
+        None,
+    )
+}
+fn wait_running(repo: &TestRepo, token: &str) -> Value {
+    let deadline = Instant::now() + Duration::from_secs(20);
+    loop {
+        if let Ok(value) = bridge(repo, "inspect", token)
+            && value["running"] == true
+            && value["ready"] == true
+        {
+            return value;
+        }
+        assert!(
+            Instant::now() < deadline,
+            "daemon did not become ready: {:?}",
+            bridge(repo, "inspect", token)
+        );
+        std::thread::sleep(Duration::from_millis(25));
+    }
+}
+#[test]
+fn managed_update_stopped_runtime_keeps_daemon_stopped_and_blocks_start_until_abort() {
+    let repo = TestRepo::new_with_daemon_scope(DaemonTestScope::NoDaemon);
+    let token = git_ai::uuid::generate_v4();
+    let inspect = bridge(&repo, "inspect", &token).unwrap();
+    assert_eq!(inspect["running"], false);
+    assert!(
+        !repo
+            .test_home_path()
+            .join(".git-ai/internal/managed-update")
+            .exists(),
+        "inspect must remain read-only"
+    );
+    let prepared = bridge(&repo, "prepare", &token).unwrap();
+    assert_eq!(prepared["durable"], true);
+    assert!(bridge(&repo, "abort", &git_ai::uuid::generate_v4()).is_err());
+    let output = command(&repo, &["bg", "run"]).output().unwrap();
+    assert!(!output.status.success());
+    assert_eq!(bridge(&repo, "abort", &token).unwrap()["phase"], "normal");
+    assert_eq!(bridge(&repo, "abort", &token).unwrap()["running"], false);
+}
+#[test]
+fn managed_update_live_daemon_drains_stops_validates_and_resumes() {
+    let repo = TestRepo::new_with_daemon_scope(DaemonTestScope::NoDaemon);
+    let token = git_ai::uuid::generate_v4();
+    let mut child = ProcessGuard(
+        command(&repo, &["bg", "run"])
+            .stdin(Stdio::null())
+            .stdout(Stdio::null())
+            .stderr(Stdio::inherit())
+            .spawn()
+            .unwrap(),
+    );
+    let before = wait_running(&repo, &token);
+    assert_eq!(before["protocol"], 1);
+    // Real trace2 commit/checkpoint work must survive the process replacement.
+    let file = repo.path().join("managed.txt");
+    std::fs::write(&file, "base\n").unwrap();
+    traced_git(&repo, &["add", "."]).unwrap();
+    traced_git(&repo, &["commit", "-m", "managed base"]).unwrap();
+    run(&repo, &["checkpoint", "human"]).unwrap();
+    std::fs::write(&file, "base\nai contribution\n").unwrap();
+    run(&repo, &["checkpoint", "mock_ai", "managed.txt"]).unwrap();
+    traced_git(&repo, &["add", "."]).unwrap();
+    traced_git(&repo, &["commit", "-m", "managed attribution"]).unwrap();
+    let deadline = Instant::now() + Duration::from_secs(20);
+    while bridge(&repo, "inspect", &token).unwrap()["busy"] == true {
+        assert!(
+            Instant::now() < deadline,
+            "accepted repository work did not drain"
+        );
+        std::thread::sleep(Duration::from_millis(25));
+    }
+    // A foreground command waiting for hook input owns an OS lease, so prepare
+    // cannot mistake a quiet daemon for an idle installation.
+    let mut foreground = ProcessGuard(
+        command(&repo, &["checkpoint", "codex", "--hook-input", "stdin"])
+            .stdin(Stdio::piped())
+            .stdout(Stdio::null())
+            .stderr(Stdio::null())
+            .spawn()
+            .unwrap(),
+    );
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while bridge(&repo, "inspect", &token).unwrap()["busy"] != true {
+        assert!(Instant::now() < deadline, "foreground lease not observed");
+        std::thread::sleep(Duration::from_millis(10));
+    }
+    assert!(
+        bridge(&repo, "prepare", &token)
+            .unwrap_err()
+            .contains("busy")
+    );
+    drop(foreground.0.stdin.take());
+    foreground.0.wait().unwrap();
+    let prepared = bridge(&repo, "prepare", &token).unwrap();
+    assert_eq!(prepared["quiesced"], true);
+    assert_eq!(prepared["durable"], true);
+    let authorship_before = repo.git(&["notes", "--ref=ai", "show", "HEAD"]).unwrap();
+    assert!(
+        authorship_before.contains("mock_ai"),
+        "real checkpoint attribution missing"
+    );
+    let status = command(&repo, &["status"]).output().unwrap();
+    assert_eq!(status.status.code(), Some(75));
+    let stopped = bridge(&repo, "stop", &token).unwrap();
+    assert_eq!(stopped["phase"], "stopping");
+    let deadline = Instant::now() + Duration::from_secs(20);
+    while child.0.try_wait().unwrap().is_none() {
+        assert!(Instant::now() < deadline, "daemon did not exit gracefully");
+        std::thread::sleep(Duration::from_millis(25));
+    }
+    let validation = bridge(&repo, "start", &token).unwrap();
+    assert_eq!(validation["phase"], "validating");
+    assert_eq!(validation["ready"], true);
+    assert_ne!(validation["pid"], before["pid"]);
+    assert_eq!(bridge(&repo, "health", &token).unwrap()["validation"], true);
+    let resumed = bridge(&repo, "resume", &token).unwrap();
+    assert_eq!(resumed["phase"], "normal");
+    assert_eq!(resumed["validation"], false);
+    assert_eq!(
+        repo.git(&["notes", "--ref=ai", "show", "HEAD"]).unwrap(),
+        authorship_before
+    );
+    bridge(&repo, "prepare", &token).unwrap();
+    bridge(&repo, "stop", &token).unwrap();
+    let deadline = Instant::now() + Duration::from_secs(20);
+    loop {
+        if let Ok(value) = bridge(&repo, "inspect", &token)
+            && value["running"] == false
+        {
+            break;
+        }
+        assert!(Instant::now() < deadline, "validation daemon did not stop");
+        std::thread::sleep(Duration::from_millis(25));
+    }
+}
+
+#[test]
+fn managed_update_identity_is_offline_and_does_not_create_runtime_state() {
+    let repo = TestRepo::new_with_daemon_scope(DaemonTestScope::NoDaemon);
+    let value = bridge(&repo, "identity", "")
+        .expect("candidate identity must not contact the installed daemon");
+    assert_eq!(value["protocol"], 1);
+    assert_eq!(value["managed"], true);
+    assert_eq!(value["data_schema"], 1);
+    assert!(value["wrapper_version"].is_string());
+    assert!(
+        !repo
+            .test_home_path()
+            .join(".git-ai/internal/managed-update")
+            .exists()
+    );
+}
+
+#[test]
+fn managed_update_renamed_candidate_still_exposes_offline_identity() {
+    let repo = TestRepo::new_with_daemon_scope(DaemonTestScope::NoDaemon);
+    let original =
+        repo.git_ai_command_without_pre_sync_for_test(&["managed-update", "identity"], &[]);
+    let dir = tempfile::tempdir().unwrap();
+    let candidate = dir.path().join(if cfg!(windows) {
+        "bridge-git-ai.exe"
+    } else {
+        "bridge-git-ai"
+    });
+    std::fs::copy(original.get_program(), &candidate).unwrap();
+    let output = std::process::Command::new(candidate)
+        .args(["managed-update", "identity"])
+        .output()
+        .unwrap();
+    assert!(
+        output.status.success(),
+        "renamed bridge incorrectly dispatched to Git: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    let value: Value = serde_json::from_slice(&output.stdout).unwrap();
+    assert_eq!(value["managed"], true);
+}
