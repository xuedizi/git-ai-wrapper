+#[test]
+fn managed_update_bg_start_preserves_binding_through_canonical_executable() {
+    let repo = TestRepo::new_with_daemon_scope(DaemonTestScope::NoDaemon);
+    // bg start canonicalizes the child executable, unlike direct bg run.
+    let mut start = command(&repo, &["bg", "start"]);
+    let db = repo.test_home_path().join("metrics.db");
+    start.env("GIT_AI_TEST_DB_PATH", &db);
+    let output = start.output().unwrap();
+    assert!(
+        output.status.success(),
+        "{}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    let token = git_ai::uuid::generate_v4();
+    for action in ["inspect", "prepare", "stop"] {
+        let output = command(&repo, &["managed-update", action, "--transaction", &token])
+            .env("GIT_AI_TEST_DB_PATH", &db)
+            .output()
+            .unwrap();
+        assert!(
+            output.status.success(),
+            "{}",
+            String::from_utf8_lossy(&output.stdout)
+        );
+    }
+}
