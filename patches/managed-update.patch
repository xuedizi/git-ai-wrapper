new file mode 100644
index 0000000..4f4f3e3
--- /dev/null
+++ b/src/managed_update/platform.rs
@@ -0,0 +1,263 @@
+//! Windows ownership, protected DACL and durable replacement for maintenance state.
+use crate::error::GitAiError;
+use std::{ffi::c_void, os::windows::ffi::OsStrExt, path::Path, ptr};
+use windows_sys::Win32::{
+    Foundation::{CloseHandle, HANDLE, LocalFree},
+    Security::{
+        Authorization::{
+            ConvertSidToStringSidW, ConvertStringSecurityDescriptorToSecurityDescriptorW,
+            GetNamedSecurityInfoW, SE_FILE_OBJECT, SetNamedSecurityInfoW,
+        },
+        DACL_SECURITY_INFORMATION, EqualSid, GetSecurityDescriptorDacl, GetTokenInformation,
+        OWNER_SECURITY_INFORMATION, PROTECTED_DACL_SECURITY_INFORMATION, TOKEN_QUERY, TOKEN_USER,
+        TokenUser,
+    },
+    Storage::FileSystem::{MOVEFILE_REPLACE_EXISTING, MOVEFILE_WRITE_THROUGH, MoveFileExW},
+    System::Threading::{GetCurrentProcess, OpenProcessToken},
+};
+
+fn wide(path: &Path) -> Result<Vec<u16>, GitAiError> {
+    let mut value: Vec<u16> = path.as_os_str().encode_wide().collect();
+    if value.contains(&0) {
+        return Err(GitAiError::Generic("NUL in managed path".into()));
+    }
+    value.push(0);
+    Ok(value)
+}
+fn last_error() -> GitAiError {
+    std::io::Error::last_os_error().into()
+}
+struct Token(HANDLE);
+impl Drop for Token {
+    fn drop(&mut self) {
+        unsafe {
+            CloseHandle(self.0);
+        }
+    }
+}
+struct Local(*mut c_void);
+impl Drop for Local {
+    fn drop(&mut self) {
+        if !self.0.is_null() {
+            unsafe {
+                LocalFree(self.0);
+            }
+        }
+    }
+}
+struct CurrentUser {
+    _storage: Vec<usize>,
+    sid: *mut c_void,
+}
+fn current_user() -> Result<CurrentUser, GitAiError> {
+    unsafe {
+        let mut handle = ptr::null_mut();
+        if OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &mut handle) == 0 {
+            return Err(last_error());
+        }
+        let token = Token(handle);
+        let mut size = 0;
+        GetTokenInformation(token.0, TokenUser, ptr::null_mut(), 0, &mut size);
+        if size == 0 {
+            return Err(last_error());
+        }
+        let mut storage = vec![0usize; (size as usize).div_ceil(std::mem::size_of::<usize>())];
+        if GetTokenInformation(
+            token.0,
+            TokenUser,
+            storage.as_mut_ptr().cast(),
+            size,
+            &mut size,
+        ) == 0
+        {
+            return Err(last_error());
+        }
+        let sid = (*(storage.as_ptr().cast::<TOKEN_USER>())).User.Sid;
+        Ok(CurrentUser {
+            _storage: storage,
+            sid,
+        })
+    }
+}
+pub(super) fn verify_owner(path: &Path) -> Result<(), GitAiError> {
+    let name = wide(path)?;
+    let user = current_user()?;
+    unsafe {
+        let mut owner = ptr::null_mut();
+        let mut descriptor = ptr::null_mut();
+        let result = GetNamedSecurityInfoW(
+            name.as_ptr(),
+            SE_FILE_OBJECT,
+            OWNER_SECURITY_INFORMATION,
+            &mut owner,
+            ptr::null_mut(),
+            ptr::null_mut(),
+            ptr::null_mut(),
+            &mut descriptor,
+        );
+        let _descriptor = Local(descriptor);
+        if result != 0 {
+            return Err(std::io::Error::from_raw_os_error(result as i32).into());
+        }
+        if owner.is_null() || EqualSid(owner, user.sid) == 0 {
+            return Err(GitAiError::Generic(
+                "managed update requires current-user ownership".into(),
+            ));
+        }
+    }
+    Ok(())
+}
+pub(super) fn make_private(path: &Path) -> Result<(), GitAiError> {
+    verify_owner(path)?;
+    let mut name = wide(path)?;
+    let user = current_user()?;
+    unsafe {
+        let mut sid_text = ptr::null_mut();
+        if ConvertSidToStringSidW(user.sid, &mut sid_text) == 0 {
+            return Err(last_error());
+        }
+        let _sid_text = Local(sid_text.cast());
+        let mut len = 0;
+        while *sid_text.add(len) != 0 {
+            len += 1;
+        }
+        let sid = String::from_utf16(std::slice::from_raw_parts(sid_text, len))
+            .map_err(|e| GitAiError::Generic(e.to_string()))?;
+        // Protected DACL. Child gate/lease files inherit only the current user's ACE.
+        let flags = if path.is_dir() { "OICI" } else { "" };
+        let sddl: Vec<u16> = format!("D:P(A;{flags};FA;;;{sid})")
+            .encode_utf16()
+            .chain(Some(0))
+            .collect();
+        let mut descriptor = ptr::null_mut();
+        if ConvertStringSecurityDescriptorToSecurityDescriptorW(
+            sddl.as_ptr(),
+            1,
+            &mut descriptor,
+            ptr::null_mut(),
+        ) == 0
+        {
+            return Err(last_error());
+        }
+        let _descriptor = Local(descriptor);
+        let mut present = 0;
+        let mut defaulted = 0;
+        let mut dacl = ptr::null_mut();
+        if GetSecurityDescriptorDacl(descriptor, &mut present, &mut dacl, &mut defaulted) == 0
+            || present == 0
+            || dacl.is_null()
+        {
+            return Err(last_error());
+        }
+        let result = SetNamedSecurityInfoW(
+            name.as_mut_ptr(),
+            SE_FILE_OBJECT,
+            DACL_SECURITY_INFORMATION | PROTECTED_DACL_SECURITY_INFORMATION,
+            ptr::null_mut(),
+            ptr::null_mut(),
+            dacl,
+            ptr::null_mut(),
+        );
+        if result != 0 {
+            return Err(std::io::Error::from_raw_os_error(result as i32).into());
+        }
+    }
+    Ok(())
+}
+pub(super) fn replace(from: &Path, to: &Path) -> Result<(), GitAiError> {
+    let from = wide(from)?;
+    let to = wide(to)?;
+    if unsafe {
+        MoveFileExW(
+            from.as_ptr(),
+            to.as_ptr(),
+            MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH,
+        )
+    } == 0
+    {
+        return Err(last_error());
+    }
+    Ok(())
+}
+
+/// The dedicated namespace is protected and grants access only to its owner.
+/// Reject unexpected ACLs; never silently repair a possibly tampered namespace.
+pub(super) fn verify_private(path: &Path) -> Result<(), GitAiError> {
+    use windows_sys::Win32::Security::{
+        ACCESS_ALLOWED_ACE, ACE_HEADER, GetAce, GetSecurityDescriptorControl, SE_DACL_PROTECTED,
+    };
+    use windows_sys::Win32::System::SystemServices::ACCESS_ALLOWED_ACE_TYPE;
+    verify_owner(path)?;
+    let name = wide(path)?;
+    let user = current_user()?;
+    unsafe {
+        let mut dacl = ptr::null_mut();
+        let mut descriptor = ptr::null_mut();
+        let result = GetNamedSecurityInfoW(
+            name.as_ptr(),
+            SE_FILE_OBJECT,
+            DACL_SECURITY_INFORMATION,
+            ptr::null_mut(),
+            ptr::null_mut(),
+            &mut dacl,
+            ptr::null_mut(),
+            &mut descriptor,
+        );
+        let _descriptor = Local(descriptor);
+        if result != 0 {
+            return Err(std::io::Error::from_raw_os_error(result as i32).into());
+        }
+        let mut control = 0;
+        let mut revision = 0;
+        if dacl.is_null()
+            || GetSecurityDescriptorControl(descriptor, &mut control, &mut revision) == 0
+            || control & SE_DACL_PROTECTED == 0
+            || (*dacl).AceCount == 0
+        {
+            return Err(GitAiError::Generic(
+                "managed namespace requires a protected owner-only DACL".into(),
+            ));
+        }
+        for index in 0..(*dacl).AceCount {
+            let mut ace = ptr::null_mut();
+            if GetAce(dacl, u32::from(index), &mut ace) == 0 {
+                return Err(last_error());
+            }
+            let header = &*(ace.cast::<ACE_HEADER>());
+            if u32::from(header.AceType) != ACCESS_ALLOWED_ACE_TYPE {
+                return Err(GitAiError::Generic(
+                    "unexpected ACE in managed namespace".into(),
+                ));
+            }
+            let allowed = &*(ace.cast::<ACCESS_ALLOWED_ACE>());
+            let sid = ptr::addr_of!(allowed.SidStart).cast::<c_void>();
+            if EqualSid(sid as *mut c_void, user.sid) == 0 {
+                return Err(GitAiError::Generic(
+                    "managed namespace grants another principal access".into(),
+                ));
+            }
+        }
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn managed_windows_private_state_remains_readable_and_replaceable() {
+        let dir = tempfile::tempdir().unwrap();
+        make_private(dir.path()).unwrap();
+        verify_private(dir.path()).unwrap();
+        let first = dir.path().join("state.json");
+        let next = dir.path().join("next.json");
+        std::fs::write(&first, b"old").unwrap();
+        std::fs::write(&next, b"new").unwrap();
+        make_private(&first).unwrap();
+        make_private(&next).unwrap();
+        verify_owner(&first).unwrap();
+        verify_private(&first).unwrap();
+        replace(&next, &first).unwrap();
+        assert_eq!(std::fs::read(&first).unwrap(), b"new");
+    }
+}
